import sprig.runtime.host.HostSystem as HostSystem

func arguments() -> List[String] throws Error:
    let values: MutableList[String] = []
    var index: Int = 0
    while index < HostSystem.argumentCount():
        values.append(argument(index))
        index += 1
    return values.toList()

func argument(index: Int) -> String throws Error:
    if index < 0 or index >= HostSystem.argumentCount():
        throw Error("argument index out of bounds: " + index.toString())
    let value = HostSystem.argument(index)
    if value != null:
        return value
    throw Error("host argument returned null")

func environment(name: String) -> String?:
    return HostSystem.environment(name)
