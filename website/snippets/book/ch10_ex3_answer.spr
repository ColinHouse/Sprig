import "@std/random.spr" as random

func play(secret: Int, guesses: List[String]) -> Unit:
    var tries = 0
    for text in guesses:
        let guess = text.toIntOrNull()
        if guess == null:
            print("skipped: " + text)
            continue
        if guess < 1 or guess > 100:
            print("out of range: " + text)
            continue
        tries += 1
        if guess == secret:
            print("correct in " + tries + " tries")
            return
        if guess < secret:
            print("too low")
        else:
            print("too high")

let secret = random.seeded(7).next_int(100) + 1
play(secret, ["0", "200", "10", "21"])
