# When either side of + is a String it joins; other values become text automatically. There is no interpolation syntax.
let item = "tea"
let count = 3
print(item + " x " + count)
print("length " + item.length())
print(item.toUpperCase() + " " + item.substring(0, 1))
print("a,b,c".split(","))
print("  padded  ".trim())
print("é😀".length())
print("é😀"[1])
