import java.lang.InterruptedException as InterruptedException
import java.lang.System as System
import java.lang.Thread as Thread
import sprig.runtime.host.HostSystem as HostSystem

func epoch_millis() -> Int:
    return HostSystem.epochMillis()

func utc_now() -> String throws Error:
    let value = HostSystem.utcNow()
    if value != null:
        return value
    throw Error("host utc_now returned null")

func format_utc(epoch_millis: Int) -> String throws Error:
    let value = HostSystem.formatUtc(epoch_millis)
    if value != null:
        return value
    throw Error("host format_utc returned null")

func parse_utc(value: String) -> Int throws Error:
    return HostSystem.parseUtc(value)

# Pauses the program for that many milliseconds.
func sleep(millis: Int) -> Unit throws Error:
    if millis < 0:
        throw Error("sleep millis must not be negative: " + millis)
    try:
        Thread.sleep(millis)
    catch problem: InterruptedException:
        throw Error("sleep was interrupted")

# A monotonic clock reading in nanoseconds for measuring elapsed time. It has
# no relation to the wall clock; only differences between two readings mean
# anything.
func monotonic_nanos() -> Int:
    return System.nanoTime()
