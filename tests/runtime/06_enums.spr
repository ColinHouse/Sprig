# Enums and exhaustive match over payloadless cases.

enum Direction:
    North
    East
    South
    West

func turn_right(direction: Direction) -> Direction:
    match direction:
        case Direction.North:
            return Direction.East
        case Direction.East:
            return Direction.South
        case Direction.South:
            return Direction.West
        case Direction.West:
            return Direction.North

func name_of(direction: Direction) -> String:
    match direction:
        case Direction.North:
            return "N"
        case Direction.East:
            return "E"
        case Direction.South:
            return "S"
        case Direction.West:
            return "W"

var current = Direction.North
for i in range(4):
    print(name_of(current))
    current = turn_right(current)
print(current == Direction.North)
