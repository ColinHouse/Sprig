{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:func|class|enum|variant|generic|if|elif|else|while|for|try|catch|finally|match|case)\\b[^#]*:\\s*(?:#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*[A-Za-z_][A-Za-z_0-9]*:\\s*(?:#.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
