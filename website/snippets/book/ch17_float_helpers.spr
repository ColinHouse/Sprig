print(Float.sqrt(2.0))
print(Float.floor(-1.5))
print(Float.ceil(-1.5))
print(Float.abs(-2.5))
print(Float.sqrt(-1.0))
print(0.1 + 0.2)
print(1.0 / 0.0)
print(0.0 / 0.0)
print(-0.0 == 0.0)
print((0.1 + 0.2).approxEqual(0.3, 1e-15))
print((0.0 / 0.0).isNaN())
print((1.0 / 0.0).isInfinite())
print(1.0.isFinite())
