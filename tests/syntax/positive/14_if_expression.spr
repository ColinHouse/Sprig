enum Flag:
    On
    Off

# An if at the start of a statement is the if statement; its else is optional.
let count = 3
if count > 1:
    print("many")

# Everywhere else, if/elif/else with one expression per branch is an if expression.
let label = if count == 1:
    "one"
elif count == 2:
    "two"
else:
    "many"

func pick(flag: Flag, n: Int) -> Int:
    return match flag:
        case Flag.On:
            if n > 0:
                n
            else:
                0
        case Flag.Off:
            -1

func fail(code: Int) -> Int throws Error:
    throw if code == 1:
        Error("one")
    else:
        Error("other")

class Box:
    let size: Int = if count > 2:
        count
    else:
        2

var total = 0
total += if count > 2:
    match Flag.On:
        case Flag.On:
            1
        case Flag.Off:
            2
else:
    3
let sign = fn(n: Int) => if n < 0:
    -1
else:
    1
print(label + pick(Flag.On, count) + sign(total) + Box().size)
