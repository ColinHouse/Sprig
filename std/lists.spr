# Sorting, grouping and folding for List[T]. Each function returns a new list
# and leaves its input unchanged. The functions that take a callable are
# rethrows: a call throws exactly what the callable throws, so a lambda that
# cannot fail makes an ordinary call and one that calls a throwing function
# makes a call that needs 'throws Error' or try/catch.
import sprig.runtime.host.HostOrder as HostOrder

# One group from group_by: a key and the items with that key, in input order.
generic K, T:
    class Group:
        let key: K
        let items: List[T]

# Stable: items with equal keys keep their input order. Keys use the same
# order as MutableList.sort(), so Float keys put -0.0 before 0.0 and NaN last.
generic T, K:
    func sort_by(items: List[T], key: fn(T) -> K throws Error) -> List[T] rethrows:
        requires K: Comparable
        let keys: MutableList[K] = []
        var order: MutableList[Int] = []
        for item in items:
            order.append(keys.size())
            keys.append(key(item))
        let count = keys.size()
        var width = 1
        while width < count:
            let merged: MutableList[Int] = []
            var start = 0
            while start < count:
                var middle = start + width
                if middle > count:
                    middle = count
                var end = middle + width
                if end > count:
                    end = count
                var left = start
                var right = middle
                while left < middle or right < end:
                    if right >= end or (left < middle and HostOrder.compare(keys.get(order.get(right)), keys.get(order.get(left))) >= 0):
                        merged.append(order.get(left))
                        left += 1
                    else:
                        merged.append(order.get(right))
                        right += 1
                start = end
            order = merged
            width = width * 2
        let sorted: MutableList[T] = []
        for index in order:
            sorted.append(items.get(index))
        return sorted.toList()

# Groups appear in first-seen key order and keep input order inside each group.
# Keys match with Sprig ==, so a NaN key never joins another group and -0.0
# joins 0.0; the group keeps the first key it saw.
generic T, K:
    func group_by(items: List[T], key: fn(T) -> K throws Error) -> List[Group[K, T]] rethrows:
        requires K: Equatable
        let keys: MutableList[K] = []
        let buckets: MutableList[MutableList[T]] = []
        for item in items:
            let value = key(item)
            var found = -1
            var index = 0
            while index < keys.size():
                if keys.get(index) == value:
                    found = index
                    break
                index += 1
            if found < 0:
                keys.append(value)
                let bucket: MutableList[T] = []
                bucket.append(item)
                buckets.append(bucket)
            else:
                buckets.get(found).append(item)
        let groups: MutableList[Group[K, T]] = []
        var position = 0
        while position < keys.size():
            groups.append(Group[K, T](key=keys.get(position), items=buckets.get(position).toList()))
            position += 1
        return groups.toList()

# Combines the items from left to right, starting from initial: for [a, b] the
# result is step(step(initial, a), b). An empty list gives initial.
generic T, A:
    func fold(items: List[T], initial: A, step: fn(A, T) -> A throws Error) -> A rethrows:
        var result = initial
        for item in items:
            result = step(result, item)
        return result

# The first item the test accepts, in list order, or null when none does.
generic T:
    func find(items: List[T], accept: fn(T) -> Bool throws Error) -> T? rethrows:
        for item in items:
            if accept(item):
                return item
        return null

# True when the test accepts some item; stops at the first item it accepts.
# An empty list gives false.
generic T:
    func any(items: List[T], accept: fn(T) -> Bool throws Error) -> Bool rethrows:
        for item in items:
            if accept(item):
                return true
        return false

# True when the test accepts every item; stops at the first item it rejects.
# An empty list gives true.
generic T:
    func all(items: List[T], accept: fn(T) -> Bool throws Error) -> Bool rethrows:
        for item in items:
            if not accept(item):
                return false
        return true

# The number of items the test accepts.
generic T:
    func count(items: List[T], accept: fn(T) -> Bool throws Error) -> Int rethrows:
        var total = 0
        for item in items:
            if accept(item):
                total += 1
        return total

# Int totals use checked arithmetic: an overflow fails like any other Int
# overflow. Other numeric types use fold.
func sum(values: List[Int]) -> Int:
    var total = 0
    for value in values:
        total += value
    return total

# The sum of amount(item) over the items, 0 for an empty list; checked, so an
# overflow fails like any other Int overflow.
generic T:
    func sum_by(items: List[T], amount: fn(T) -> Int throws Error) -> Int rethrows:
        var total = 0
        for item in items:
            total += amount(item)
        return total

# Ascending and stable, in the order of MutableList.sort().
generic T:
    func sorted(items: List[T]) -> List[T]:
        requires T: Comparable
        let copy = items.toMutableList()
        copy.sort()
        return copy.toList()

# The largest item, or null for an empty list; of equal items, the first wins.
# Items use the order of sorted, so for Float NaN is the largest value and -0.0
# is below 0.0.
generic T:
    func max(items: List[T]) -> T?:
        requires T: Comparable
        if items.size() == 0:
            return null
        var best = items.get(0)
        for item in items:
            if HostOrder.compare(item, best) > 0:
                best = item
        return best

# The smallest item, or null for an empty list; of equal items, the first
# wins. Items use the order of sorted, so for Float NaN is the largest value and
# -0.0 is below 0.0.
generic T:
    func min(items: List[T]) -> T?:
        requires T: Comparable
        if items.size() == 0:
            return null
        var best = items.get(0)
        for item in items:
            if HostOrder.compare(item, best) < 0:
                best = item
        return best

# The item with the largest key, or null for an empty list; of items with
# equal keys, the first wins. Keys use the order of sort_by, and key runs once
# per item.
generic T, K:
    func max_by(items: List[T], key: fn(T) -> K throws Error) -> T? rethrows:
        requires K: Comparable
        if items.size() == 0:
            return null
        var best = items.get(0)
        var best_key = key(best)
        var index = 1
        while index < items.size():
            let item = items.get(index)
            let item_key = key(item)
            if HostOrder.compare(item_key, best_key) > 0:
                best = item
                best_key = item_key
            index += 1
        return best

# The item with the smallest key, or null for an empty list; of items with
# equal keys, the first wins. Keys use the order of sort_by, and key runs once
# per item.
generic T, K:
    func min_by(items: List[T], key: fn(T) -> K throws Error) -> T? rethrows:
        requires K: Comparable
        if items.size() == 0:
            return null
        var best = items.get(0)
        var best_key = key(best)
        var index = 1
        while index < items.size():
            let item = items.get(index)
            let item_key = key(item)
            if HostOrder.compare(item_key, best_key) < 0:
                best = item
                best_key = item_key
            index += 1
        return best

# An item with its position, from enumerate.
generic T:
    class Indexed:
        let index: Int
        let value: T

# Two items side by side, from zip.
generic A, B:
    class Pair:
        let first: A
        let second: B

# The first item, or null for an empty list.
generic T:
    func first(items: List[T]) -> T?:
        if items.size() == 0:
            return null
        return items.get(0)

# The last item, or null for an empty list.
generic T:
    func last(items: List[T]) -> T?:
        if items.size() == 0:
            return null
        return items.get(items.size() - 1)

# The first count items, or every item when the list is shorter.
generic T:
    func take(items: List[T], count: Int) -> List[T] throws Error:
        if count < 0:
            throw Error("take count must not be negative: " + count)
        let out: MutableList[T] = []
        var index = 0
        while index < items.size() and index < count:
            out.append(items.get(index))
            index += 1
        return out.toList()

# Every item after the first count, or nothing when the list is shorter.
generic T:
    func drop(items: List[T], count: Int) -> List[T] throws Error:
        if count < 0:
            throw Error("drop count must not be negative: " + count)
        let out: MutableList[T] = []
        var index = count
        while index < items.size():
            out.append(items.get(index))
            index += 1
        return out.toList()

# The items in reverse order, as a new list.
generic T:
    func reversed(items: List[T]) -> List[T]:
        let out: MutableList[T] = []
        var index = items.size() - 1
        while index >= 0:
            out.append(items.get(index))
            index -= 1
        return out.toList()

# Each distinct item once, at the position of its first occurrence. Items
# are compared the way map keys are.
generic T:
    func distinct(items: List[T]) -> List[T]:
        let seen: MutableMap[T, Bool] = {}
        let out: MutableList[T] = []
        for item in items:
            if not seen.containsKey(item):
                seen.set(item, true)
                out.append(item)
        return out.toList()

# The position of the first item equal to the value, or -1.
generic T:
    func index_of(items: List[T], value: T) -> Int:
        requires T: Equatable
        var index = 0
        for item in items:
            if item == value:
                return index
            index += 1
        return -1

# Every item with its index, counting from 0, in list order.
generic T:
    func enumerate(items: List[T]) -> List[Indexed[T]]:
        let out: MutableList[Indexed[T]] = []
        var index = 0
        for item in items:
            out.append(Indexed[T](index=index, value=item))
            index += 1
        return out.toList()

# Pairs of items at the same position, as long as the shorter list.
generic A, B:
    func zip(left: List[A], right: List[B]) -> List[Pair[A, B]]:
        let out: MutableList[Pair[A, B]] = []
        var index = 0
        while index < left.size() and index < right.size():
            out.append(Pair[A, B](first=left.get(index), second=right.get(index)))
            index += 1
        return out.toList()
