# A branch value that starts with '(' and holds a generic witness with a comma
# compiles: yield goes through a local (#154).
enum C:
    A
    B
func m(c: C) -> Int:
    return match c:
        case C.A:
            ({"k": 4}).size()
        case C.B:
            7
print(m(C.A))
print(m(C.B))
let v = match C.B:
    case C.A:
        ({"k": 1, "j": 2}).size()
    case C.B:
        {"only": 1}.size()
print(v)
