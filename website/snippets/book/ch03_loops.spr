var total = 0
for n in range(1, 5):
    total += n
print(total)

var i = 10
while i > 0:
    i -= 3
print(i)

for word in ["tea", "milk", "rice"]:
    if word == "milk":
        continue
    print(word)

var found = -1
for n in range(100):
    if n * n > 50:
        found = n
        break
print(found)
