import "@std/lists.spr" as lists

class Expense:
    let item: String
    let category: String
    let cents: Int

let expenses: List[Expense] = [
    Expense(item="Coffee", category="food", cents=1250),
    Expense(item="Taxi", category="transport", cents=3600),
    Expense(item="Lunch", category="food", cents=1800),
]

for expense in lists.sort_by(expenses, fn(e: Expense) => e.cents):
    print(expense.item)

for group in lists.group_by(expenses, fn(e: Expense) => e.category):
    let total = lists.sum_by(group.items, fn(e: Expense) => e.cents)
    print(group.key + ": " + total)

let ride = lists.find(expenses, fn(e: Expense) => e.category == "transport")
if ride != null:
    print("first ride: " + ride.item)
print(lists.any(expenses, fn(e: Expense) => e.cents > 3000))
print(lists.count(expenses, fn(e: Expense) => e.category == "food"))
