# No operator overloading: give the operation a method name.
class Vec:
    let x: Int
    let y: Int

    func plus(other: Vec) -> Vec:
        return Vec(x=x + other.x, y=y + other.y)

    func show() -> String:
        return "(" + x + ", " + y + ")"

let v = Vec(x=1, y=2).plus(Vec(x=3, y=4))
print(v.show())
