generic T:
    class Box:
        let value: T

generic T:
    func first_or(items: List[T], fallback: T) -> T:
        if items.size() == 0:
            return fallback
        return items[0]

generic T:
    func largest(items: List[T]) -> T throws Error:
        requires T: Comparable
        if items.size() == 0:
            throw Error("no items")
        var best = items[0]
        for item in items:
            if item > best:
                best = item
        return best

let box = Box(value=42)
print(box.value)
let named = Box[String](value="x")
print(named.value)
print(first_or([3, 1], 0))
print(first_or([], "none"))
print(largest([3, 9, 4]))
print(largest(["pear", "apple"]))
