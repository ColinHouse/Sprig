# An if expression chooses a value. Each branch is one expression on its
# own line, and the else branch is required.
let count = 3
let label = if count == 1:
    "1 item"
else:
    count + " items"
print(label)

func shipping(cents: Int) -> Int:
    return if cents >= 5000:
        0
    elif cents >= 2000:
        299
    else:
        499

print(shipping(6400))
print(shipping(1200))

# Narrowing is the if statement's: after name == null, the elif and the
# else both use name directly.
func greet(name: String?) -> String:
    return if name == null:
        "Hello, stranger"
    elif name.length() > 8:
        "Hello, " + name.substring(0, 8) + "..."
    else:
        "Hello, " + name

print(greet(null))
print(greet("Ada"))
print(greet("Bartholomew"))
