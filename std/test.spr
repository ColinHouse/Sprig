# Test facilities are ordinary functions; cases remain ordinary Sprig programs.
import "@std/process.spr" as process
import sprig.runtime.SprigRuntime as SprigRuntime
import sprig.runtime.test.HostTest as HostTest

export process.ProcessResult

# The fresh directory sprig test creates for this test file and deletes when
# the test ends; every call returns the same path. Outside sprig test (no
# SPRIG_TEST_TMPDIR directory) it is an Error.
func temp_dir() -> String throws Error:
    let location = HostTest.tempDir()
    if location != null:
        return location
    throw Error("test host returned no temporary directory")

# The same child process helper as process.run, kept under its earlier name.
func run_process(command: List[String]) -> process.ProcessResult throws Error:
    return process.run(command)

# Cases run as they are declared, so a failing case does not stop the ones
# after it. The two counters below are the program's tally; finish() reports it.

# Internal: passed checks so far, counted by check and check_error for
# finish(); test code calls finish() rather than reading it.
var passed_cases = 0
# Internal: failed checks so far, counted by check and check_error for
# finish(); test code calls finish() rather than reading it.
var failed_cases = 0

# Runs one named check now. It passes when the body returns and fails when the
# body throws Error, in which case the message is printed after the name.
func check(name: String, body: fn() -> Unit throws Error) -> Unit:
    try:
        body()
        passed_cases += 1
        print("ok " + name)
    catch problem: Error:
        failed_cases += 1
        print("FAIL " + name + ": " + problem)

# Passes when the body throws Error and fails when it returns. The body may
# return a value; T is the type of the lambda's result:
# test.check_error("rejects text", fn() => parse("x")).
generic T:
    func check_error(name: String, body: fn() -> T throws Error) -> Unit:
        try:
            body()
        catch problem: Error:
            passed_cases += 1
            print("ok " + name)
            return
        failed_cases += 1
        print("FAIL " + name + ": no Error was thrown")

# Prints the tally and ends the program with status 1 when a case failed, so
# sprig test reports the program as failed.
func finish() -> Unit:
    print(passed_cases + " passed, " + failed_cases + " failed")
    if failed_cases > 0:
        process.exit(1)

# A failed check throws an Error that names both values, so the report shows
# what differed. `what` says which value was checked.
func equal_int(actual: Int, expected: Int, what: String) -> Unit throws Error:
    if actual != expected:
        throw Error(what + ": expected " + expected + ", got " + actual)

# Like equal_int for Bool: nothing happens when the values are equal, otherwise
# it throws an Error such as `done: expected true, got false`.
func equal_bool(actual: Bool, expected: Bool, what: String) -> Unit throws Error:
    if actual != expected:
        throw Error(what + ": expected " + expected + ", got " + actual)

# Both texts are shown quoted with \\, \", \n, \r and \t escaped, so a
# difference in line endings or surrounding spaces is visible.
func equal_text(actual: String, expected: String, what: String) -> Unit throws Error:
    if actual != expected:
        let wanted = expected.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
        let found = actual.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
        throw Error(what + ": expected \"" + wanted + "\", got \"" + found + "\"")

# Any value that supports ==, lists and maps included; both values are shown
# the way print shows them.
generic T:
    func equal(actual: T, expected: T, what: String) -> Unit throws Error:
        requires T: Equatable
        if actual != expected:
            throw Error(what + ": expected " + shown[T](expected) + ", got " + shown[T](actual))

# Internal: the text print shows for a value, for equal's failure message;
# callers use value.toString(), which gives the same text.
generic T:
    func shown(value: T) -> String:
        let text = SprigRuntime.str(value)
        if text != null:
            return text
        return "null"
