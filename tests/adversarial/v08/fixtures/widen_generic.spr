generic T:
    class Box:
        var value: T
        func set(x: T) -> Unit:
            value = x
        func get() -> T:
            return value
generic T:
    func identity(x: T) -> T:
        return x
let n: Int32 = 7
let f: Float32 = 1.5
let b = Box[Int](value=n)
print(b.get())
b.set(n)
print(b.value)
b.value = n
print(b.get())
print(identity[Int](n))
print(Box[Float](value=f).get())
print(identity[Float](f))
