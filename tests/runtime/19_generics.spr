# v0.8 user-defined generics: explicit type arguments at every use.
# One type parameter per block; erasure and boxing are compiler-controlled.

generic T:
    class Box:
        let value: T

generic T:
    func identity(value: T) -> T:
        return value

generic T:
    func present(value: T?) -> Bool:
        return value != null

generic T:
    variant Option:
        Some:
            value: T
        None:

generic T:
    func unwrap(value: Option[T]) -> T?:
        match value:
            case Option.Some as some:
                return some.value
            case Option.None:
                return null

func double(value: Int) -> Int:
    return value * 2

let box_int = Box[Int](value=41)
print(identity[Int](box_int.value) + 1)
print(identity[Int32](8))
print(identity[Float](1.5))
print(identity[Float32](2.5))
print(identity[Bool](true))
print(identity[String]("hi"))
print(identity[String?](null))
print(identity[BigInt](BigInt.fromInt(5)))
print(identity[Decimal](Decimal.fromInt(3)))
print(present[String]("here"))
print(present[String](null))

let nested: List[Option[Int]] = [Option[Int].Some(value=7), Option[Int].None]
for item in nested:
    let value = unwrap[Int](item)
    if value != null:
        print(value)

let boxes: List[Box[Int]] = [Box[Int](value=1), Box[Int](value=2)]
print(boxes.get(1).value)

let keyed: Map[String, Box[Int]] = {"a": Box[Int](value=9)}
let first = keyed["a"]
if first != null:
    print(first.value)

print(double(identity[Int](21)))

generic T:
    func second(a: T, b: T) -> T:
        return b

print(second[String]("first", "second"))

# Multiple type parameters are supported without an arbitrary limit.
generic K, V:
    class Entry:
        let key: K
        let value: V

generic T, E:
    variant Result:
        Ok:
            value: T
        Err:
            error: E

generic A, B:
    func choose(first: A, second: B) -> B:
        return second

let entry = Entry[String, Int](key="age", value=18)
print(entry.key + "=" + entry.value.toString())
print(entry.value + 1)

let ok: Result[Int, String] = Result[Int, String].Ok(value=42)
let err: Result[Int, String] = Result[Int, String].Err(error="bad")
match ok:
    case Result.Ok as payload:
        print(payload.value)
    case Result.Err as payload:
        print(payload.error)
match err:
    case Result.Ok as payload:
        print(payload.value)
    case Result.Err as payload:
        print(payload.error)

print(choose[String, Int]("x", 7))

let nested_entry = Entry[String, Box[Int]](key="b", value=Box[Int](value=9))
print(nested_entry.value.value)

# The only implemented capability: equality under 'requires X: Equatable'.
generic K:
    func contains_key(keys: List[K], target: K) -> Bool:
        requires K: Equatable
        for key in keys:
            if key == target:
                return true
        return false

print(contains_key[String](["a", "b"], "b"))
print(contains_key[Int]([1, 2], 9))
