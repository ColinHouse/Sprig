# String position operations use Unicode code points; Java char interop remains UTF-16.
func join(values: List[String], separator: String) -> String:
    var output = ""
    var index: Int = 0
    while index < values.size():
        if index > 0:
            output = output + separator
        output = output + values.get(index)
        index += 1
    return output

func starts_with(value: String, prefix: String) -> Bool:
    if prefix.length() > value.length():
        return false
    return value.substring(0, prefix.length()) == prefix

func ends_with(value: String, suffix: String) -> Bool:
    if suffix.length() > value.length():
        return false
    return value.substring(value.length() - suffix.length(), value.length()) == suffix

func split(value: String, separator: String) -> List[String] throws Error:
    if separator.length() == 0:
        throw Error("split separator must not be empty")
    let output: MutableList[String] = []
    var start: Int = 0
    var index: Int = 0
    while index + separator.length() <= value.length():
        if value.substring(index, index + separator.length()) == separator:
            output.append(value.substring(start, index))
            index += separator.length()
            start = index
        else:
            index += 1
    output.append(value.substring(start, value.length()))
    return output.toList()

func lines(value: String) -> List[String]:
    let output: MutableList[String] = []
    var start: Int = 0
    var index: Int = 0
    while index < value.length():
        if value.charAt(index) == "\n":
            var end = index
            if end > start and value.charAt(end - 1) == "\r":
                end -= 1
            output.append(value.substring(start, end))
            start = index + 1
        index += 1
    output.append(value.substring(start, value.length()))
    return output.toList()

func trim(value: String) -> String:
    var start: Int = 0
    var end = value.length()
    while start < end and (value.charAt(start) == " " or value.charAt(start) == "\t" or value.charAt(start) == "\r" or value.charAt(start) == "\n"):
        start += 1
    while end > start and (value.charAt(end - 1) == " " or value.charAt(end - 1) == "\t" or value.charAt(end - 1) == "\r" or value.charAt(end - 1) == "\n"):
        end -= 1
    return value.substring(start, end)

# Pads to width code points. The fill repeats as often as needed and its last
# repetition is cut to fit. A value already that long, or an empty fill,
# returns the value unchanged.
func pad_left(value: String, width: Int, fill: String) -> String:
    if width <= value.length() or fill.length() == 0:
        return value
    let missing = width - value.length()
    return fill.repeat(missing.divTrunc(fill.length()) + 1).substring(0, missing) + value

func pad_right(value: String, width: Int, fill: String) -> String:
    if width <= value.length() or fill.length() == 0:
        return value
    let missing = width - value.length()
    return value + fill.repeat(missing.divTrunc(fill.length()) + 1).substring(0, missing)

# True for a non-empty value made only of the ASCII digits 0-9.
func is_ascii_digit(value: String) -> Bool:
    for element in value:
        let code = element.codeAt(0)
        if code < 48 or code > 57:
            return false
    return value.length() > 0

# True for a non-empty value made only of the ASCII letters A-Z and a-z.
func is_ascii_letter(value: String) -> Bool:
    for element in value:
        let code = element.codeAt(0)
        if code < 65 or (code > 90 and code < 97) or code > 122:
            return false
    return value.length() > 0
