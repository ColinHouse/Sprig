enum Direction:
    North
    East
    South
    West

func turn_right(d: Direction) -> Direction:
    return match d:
        case Direction.North:
            Direction.East
        case Direction.East:
            Direction.South
        case Direction.South:
            Direction.West
        case Direction.West:
            Direction.North

print(turn_right(Direction.North))
print(turn_right(Direction.West))
