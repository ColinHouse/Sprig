# Variants and exhaustive match with typed case bindings.

variant Expr:
    Literal(value: Int)
    Add(left: Expr, right: Expr)
    Neg(operand: Expr)
    Marker

func evaluate(expr: Expr) -> Int:
    match expr:
        case Expr.Literal as node:
            return node.value
        case Expr.Add as node:
            return evaluate(node.left) + evaluate(node.right)
        case Expr.Neg as node:
            return -evaluate(node.operand)
        case Expr.Marker:
            return 0

func render(expr: Expr) -> String:
    match expr:
        case Expr.Literal as node:
            return node.value.toString()
        case Expr.Add as node:
            return "(" + render(node.left) + " + " + render(node.right) + ")"
        case Expr.Neg as node:
            return "-" + render(node.operand)
        case Expr.Marker:
            return "?"

let tree = Expr.Add(
    left=Expr.Neg(operand=Expr.Literal(value=4)),
    right=Expr.Add(left=Expr.Literal(value=10), right=Expr.Marker)
)
print(render(tree))
print(evaluate(tree))

var maybe: Expr = Expr.Marker
if true:
    maybe = Expr.Literal(value=42)
print(evaluate(maybe))
