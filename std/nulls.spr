# The two ways a nullable read usually ends: a fallback value or an Error.
# Both take the value's type from their arguments:
# nulls.or_else(counts[key], 0) is an Int for a Map[String, Int].

# The fallback is an ordinary argument, so it is evaluated even when unused.
generic T:
    func or_else(value: T?, fallback: T) -> T:
        if value != null:
            return value
        return fallback

generic T:
    func require(value: T?, message: String) -> T throws Error:
        if value != null:
            return value
        throw Error(message)
