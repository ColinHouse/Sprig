# The program's real work. Only functions here, no top-level statements, so tests can import it.
func greeting(name: String) -> String:
    return "Hello, " + name + "!"

# Handle one command line and return the exit code.
func run(arguments: List[String]) -> Int:
    if arguments.size() != 1:
        print("usage: greet NAME")
        return 2
    print(greeting(arguments[0]))
    return 0
