# Nullable types: explicit T?, null checks, narrowing, optional results.

func find(words: List[String], target: String) -> Int?:
    for i in range(words.size()):
        if words[i] == target:
            return i
    return null

let words: List[String] = ["alpha", "beta", "gamma"]
let index = find(words, "beta")
if index != null:
    print("found at " + index.toString())
else:
    print("missing")

let other = find(words, "delta")
if other == null:
    print("delta is missing")
print(other)

func first_char(text: String) -> String?:
    if text.isEmpty():
        return null
    return text.charAt(0)

let initial = first_char("Sprig")
if initial != null:
    print(initial.toUpperCase())

let empty = first_char("")
if empty == null:
    print("no first char")

let maybe_number: Int? = null
print(maybe_number)
let fallback: Int? = 5
print(fallback)
