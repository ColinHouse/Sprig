import "@web/app.spr" as web
import "@std/json.spr" as json

let app = web.App(title="Lifecycle")
let other = web.App(title="Other")
app.get("/", fn(req: web.Request) => web.text("ok", 200))
print(app.routes.size())
print(other.routes.size())
var duplicate = false
try:
    app.get("/", fn(req: web.Request) => web.text("duplicate", 200))
catch problem: Error:
    duplicate = true
print(duplicate)
var reserved = false
try:
    app.get("/docs", fn(req: web.Request) => web.text("reserved", 200))
catch problem: Error:
    reserved = true
print(reserved)
var invalid = false
try:
    app.get("/bad/{id}/{id}", fn(req: web.Request) => web.text("bad", 200))
catch problem: Error:
    invalid = true
print(invalid)
var schema_error = false
try:
    app.route(web.Route(method=web.Method.POST, path="/bad-schema", handler=fn(req: web.Request) => web.text("ok", 200), request_schema=web.Schema(kind=web.SchemaType.ARRAY)))
catch problem: Error:
    schema_error = true
print(schema_error)
app.run(0)
print(app.port() > 0)
app.stop()
app.stop()
app.run_on("127.0.0.1", 0)
print(app.port() > 0)
app.stop()
var bad_host = false
try:
    app.run_on("", 0)
catch problem: Error:
    bad_host = true
print(bad_host)
app.put("/items/{id}", fn(req: web.Request) => web.text("put", 200))
app.patch("/items/{id}", fn(req: web.Request) => web.text("patch", 200))
print(web.method_name(web.Method.PUT) + " " + web.operation_name(web.Method.PATCH))
print(app.routes.size())
print(json.stringify(web.schema_json(web.Schema(kind=web.SchemaType.ARRAY, items=web.Schema(kind=web.SchemaType.INTEGER)))))
print(json.stringify(web.schema_json(web.Schema(kind=web.SchemaType.OBJECT, fields=[web.FieldSchema(name="enabled", schema=web.Schema(kind=web.SchemaType.BOOLEAN), required=false)]))))
# json_response reports a value it cannot write as a checked Error.
var response_error = "no error"
try:
    web.json_response(json.Value.Number(text="broken"), 200)
catch problem: Error:
    response_error = problem.message
print(response_error)
# A handler may let the Error of Request.json or json_response escape: the
# server answers 400 for a malformed body and 500 for anything else.
other.post("/json", fn(req: web.Request) => web.json_response(req.json(), 201))
print(other.routes.size())
