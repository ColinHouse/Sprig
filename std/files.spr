# Ordinary Sprig API. IO failures preserve java.io.IOException.
import sprig.runtime.host.HostFiles as HostFiles
import java.io.IOException as IOException
import "@std/text.spr" as text

func read_utf8(path: String) -> String throws IOException, Error:
    let value = HostFiles.readUtf8(path)
    if value != null:
        return value
    throw Error("host read_utf8 returned null")

func write_utf8(path: String, value: String) -> Unit throws IOException:
    HostFiles.writeUtf8(path, value)

func exists(path: String) -> Bool:
    return HostFiles.exists(path)

func is_directory(path: String) -> Bool:
    return HostFiles.isDirectory(path)

func is_file(path: String) -> Bool:
    return HostFiles.isRegularFile(path)

func make_directory(path: String) -> Unit throws IOException:
    HostFiles.makeDirectory(path)

func join(base: String, child: String) -> String throws Error:
    let value = HostFiles.join(base, child)
    if value != null:
        return value
    throw Error("host join returned null")

func normalize(path: String) -> String throws Error:
    let value = HostFiles.normalize(path)
    if value != null:
        return value
    throw Error("host normalize returned null")

func file_name(path: String) -> String throws Error:
    let value = HostFiles.fileName(path)
    if value != null:
        return value
    throw Error("host file_name returned null")

func parent(path: String) -> String?:
    return HostFiles.parent(path)

func absolute(path: String) -> String throws Error:
    let value = HostFiles.absolute(path)
    if value != null:
        return value
    throw Error("host absolute returned null")

func copy_file(source: String, target: String) -> Unit throws IOException:
    HostFiles.copyFile(source, target)

func move(source: String, target: String) -> Unit throws IOException:
    HostFiles.move(source, target)

func remove_file(path: String) -> Unit throws IOException:
    HostFiles.removeFile(path)

func atomic_write_utf8(path: String, value: String) -> Unit throws IOException:
    HostFiles.atomicWriteUtf8(path, value)

func temp_file() -> String throws IOException, Error:
    let value = HostFiles.tempFile()
    if value != null:
        return value
    throw Error("host temp_file returned null")

func list(path: String) -> List[String] throws IOException, Error:
    let snapshot = HostFiles.directory(path)
    if snapshot != null:
        let entries: MutableList[String] = []
        var index: Int = 0
        while index < snapshot.size():
            let entry = snapshot.entry(index)
            if entry != null:
                entries.append(entry)
            else:
                throw Error("host directory entry returned null")
            index += 1
        return entries.toList()
    throw Error("host directory returned null")

# The lines of a UTF-8 file without their line endings, as text.lines splits them.
func read_lines(path: String) -> List[String] throws IOException, Error:
    return text.lines(read_utf8(path))

# Every file below a directory, with absolute paths, directories first in
# sorted order and nested ones after their parent's files. Symbolic links are
# listed but not followed.
func walk(path: String) -> List[String] throws IOException, Error:
    let found: MutableList[String] = []
    for entry in list(path):
        if is_directory(entry):
            for nested in walk(entry):
                found.append(nested)
        else:
            found.append(entry)
    return found.toList()
