# Sprig owns HTTP application policy; Java owns socket/UTF-8/lifetime mechanics.
import "@std/json.spr" as jsonlib
import "@std/text.spr" as strings
import "request_helpers.spr" as request_helpers
import "routing_helpers.spr" as routing
import "openapi_helpers.spr" as openapi_helpers
import sprig.runtime.web.HostRequest as HostRequest
import sprig.runtime.web.HostResponse as HostResponse
import sprig.runtime.web.HostServer as HostServer
import sprig.runtime.web.BadRequest as BadRequest
import java.lang.RuntimeException as RuntimeException

# GET, POST, PUT, PATCH or DELETE. Requests with other methods, HEAD included,
# match no route (404); OPTIONS gets 204 when cors_origin is set.
enum Method:
    GET
    POST
    PUT
    PATCH
    DELETE

# STRING, INTEGER (int64), BOOLEAN, OBJECT (lists fields) or ARRAY (needs
# items).
enum SchemaType:
    STRING
    INTEGER
    BOOLEAN
    OBJECT
    ARRAY

# One property of an OBJECT schema, required unless required=false. Names must
# be unique within the object, or route registration throws Error.
class FieldSchema:
    let name: String
    let schema: Schema
    let required: Bool = true

# OpenAPI description of a JSON value: an OBJECT lists fields; an ARRAY needs
# items, or route registration throws Error. Requests are not validated
# against it.
class Schema:
    let kind: SchemaType
    let fields: List[FieldSchema] = []
    let items: Schema? = null

# OpenAPI metadata for a query parameter, optional unless required=true. It
# only documents the route; read the value with Request.query(name).
class QueryParameter:
    let name: String
    let schema: Schema
    let required: Bool = false

# A response header. An invalid name, a CR or LF in the value, or
# Content-Length or Transfer-Encoding makes the server answer 500 instead.
class Header:
    let name: String
    let value: String

# A path parameter: the name between the route's braces and the decoded,
# never empty, segment it matched.
class Parameter:
    let name: String
    let value: String

# Internal: the host's value, or an IllegalStateException when the host gave
# null; respond() uses it. Handlers read the Request fields instead.
func required(value: String?) -> String:
    return request_helpers.required(value)

# Internal: percent-decodes URI text as UTF-8 ("+" becomes a space when plus
# is true); malformed input throws BadRequest. Request.path, path_param and
# query are already decoded.
func decode(value: String, plus: Bool) -> String:
    return request_helpers.decode(value, plus)

# What a handler gets: the method, the percent-decoded path and the UTF-8
# body. parameters holds the path parameters, query_values each query name
# with its first decoded value (the server decodes the query once, before
# routing); raw is the server's transport request. A Request built by hand,
# as in a handler test, has only the query_values it is given.
class Request:
    let method: String
    let path: String
    let body: String
    let raw: HostRequest
    let parameters: List[Parameter] = []
    let query_values: Map[String, String] = {}

    # The decoded segment that matched {name} (an encoded "/" stays inside it,
    # "+" stays "+"); null when the route has no such parameter.
    func path_param(name: String) -> String?:
        for parameter in parameters:
            if parameter.name == name:
                return parameter.value
        return null

    # The first decoded value of that query parameter ("+" is a space); "" when
    # it is present but empty or has no "=", null when it is absent. A lookup in
    # query_values that cannot fail: the server answers a malformed query with
    # 400 before any handler runs.
    func query(name: String) -> String?:
        return query_values[name]

    # The first value of that request header, whose name matches ignoring
    # case; null when the request does not have it.
    func header(name: String) -> String?:
        return raw.header(name)

    # The body parsed with @std/json. Malformed JSON, duplicate keys included,
    # throws BadRequest, an Error: catch it to answer yourself, or let it
    # escape the handler and the client gets 400.
    func json() -> jsonlib.Value throws Error:
        return request_helpers.parse_json(body)

# What a handler returns; the body is sent as UTF-8. A status outside 200..599
# or an invalid header makes the server answer 500 instead; 204 and 304
# answers carry no body.
class Response:
    let status: Int
    let body: String
    let content_type: String = "text/plain; charset=utf-8"
    let headers: List[Header] = []

    # A copy with one more header; the original is unchanged. When a name
    # repeats in any case, the last value is sent, and Content-Type replaces
    # content_type.
    func with_header(name: String, value: String) -> Response:
        let output: MutableList[Header] = []
        for header in headers:
            output.append(header)
        output.append(Header(name=name, value=value))
        return Response(status=status, body=body, content_type=content_type, headers=output.toList())

# A text/plain; charset=utf-8 response with no extra headers.
func text(body: String, status: Int) -> Response:
    return Response(status=status, body=body)

# The value as an application/json; charset=utf-8 response. A value stringify
# rejects (a bad number lexeme, a duplicate key, nesting over 128) throws
# Error; escaping a handler, it becomes a 500 answer.
func json_response(value: jsonlib.Value, status: Int) -> Response throws Error:
    try:
        return Response(status=status, body=jsonlib.stringify(value), content_type="application/json; charset=utf-8")
    catch problem: Error:
        throw Error("cannot write the response as JSON: " + problem.message)

# One route: a method, a path such as /items/{id} (one {name} per segment), a
# handler and OpenAPI metadata (summary, schemas, response_status, query
# parameters) that only documents it: nothing is validated or enforced. An
# Error that escapes the handler becomes 400 for BadRequest, else 500.
class Route:
    let method: Method
    let path: String
    let handler: fn(Request) -> Response throws Error
    let summary: String = ""
    let request_schema: Schema? = null
    let response_schema: Schema? = null
    let response_status: Int = 200
    let query_parameters: List[QueryParameter] = []

# Internal: a Method as request text ("GET") for respond()'s matching;
# handlers compare Request.method with such text directly.
func method_name(method: Method) -> String:
    return match method:
        case Method.GET:
            "GET"
        case Method.POST:
            "POST"
        case Method.PUT:
            "PUT"
        case Method.PATCH:
            "PATCH"
        case Method.DELETE:
            "DELETE"

# Internal: a Method as its lowercase OpenAPI operation key ("get"); call
# App.openapi() for the document.
func operation_name(method: Method) -> String:
    return match method:
        case Method.GET:
            "get"
        case Method.POST:
            "post"
        case Method.PUT:
            "put"
        case Method.PATCH:
            "patch"
        case Method.DELETE:
            "delete"

# Internal: match_path()'s answer, Missing or Matched with the path parameters;
# handlers read them with Request.path_param.
variant MatchResult:
    Missing
    Matched(parameters: List[Parameter])

# Internal: the name in a whole-segment template such as {id}, else null;
# App.route() and match_path() use it.
func parameter_name(segment: String) -> String?:
    return routing.parameter_name(segment)

# Internal: the path with each {name} segment replaced by {}, so App.route()
# can find equivalent templates.
func template_shape(path: String) -> String throws Error:
    return routing.template_shape(path)

# Internal: matches a raw request path against a route template, segment by
# decoded segment; App routes requests itself, and handlers use
# Request.path_param.
func match_path(pattern: String, raw_path: String) -> MatchResult throws Error:
    let expected = strings.split(pattern, "/")
    let actual = strings.split(raw_path, "/")
    if expected.size() != actual.size():
        return MatchResult.Missing
    let parameters: MutableList[Parameter] = []
    var index: Int = 0
    while index < expected.size():
        let part = expected.get(index)
        let value = decode(actual.get(index), false)
        let name = parameter_name(part)
        if name != null:
            if value == "":
                return MatchResult.Missing
            parameters.append(Parameter(name=name, value=value))
        elif part != value:
            return MatchResult.Missing
        index += 1
    return MatchResult.Matched(parameters=parameters.toList())

# Internal: a Schema as an OpenAPI schema object, throwing Error for an ARRAY
# without items; App.openapi() returns the whole document.
func schema_json(schema: Schema) -> jsonlib.Value throws Error:
    match schema.kind:
        case SchemaType.STRING:
            return openapi_helpers.schema_type("string")
        case SchemaType.INTEGER:
            return openapi_helpers.integer_schema()
        case SchemaType.BOOLEAN:
            return openapi_helpers.schema_type("boolean")
        case SchemaType.ARRAY:
            let items = schema.items
            if items != null:
                return openapi_helpers.array_schema(schema_json(items))
            throw Error("array schema requires items")
        case SchemaType.OBJECT:
            let properties: MutableList[jsonlib.Member] = []
            let required_fields: MutableList[String] = []
            for field in schema.fields:
                properties.append(jsonlib.Member(key=field.name, value=schema_json(field.schema)))
                if field.required:
                    required_fields.append(field.name)
            return openapi_helpers.object_schema(jsonlib.Value.Object(members=properties.toList()), required_fields.toList())

# Internal: one route's OpenAPI operation object, throwing Error as
# schema_json() does; App.openapi() returns the whole document.
func operation_json(route: Route) -> jsonlib.Value throws Error:
    let parameters: MutableList[jsonlib.Value] = []
    for segment in strings.split(route.path, "/"):
        let name = parameter_name(segment)
        if name != null:
            parameters.append(jsonlib.Value.Object(members=[jsonlib.Member(key="name", value=jsonlib.Value.Text(value=name)), jsonlib.Member(key="in", value=jsonlib.Value.Text(value="path")), jsonlib.Member(key="required", value=jsonlib.Value.Boolean(value=true)), jsonlib.Member(key="schema", value=schema_json(Schema(kind=SchemaType.STRING)))]))
    for parameter in route.query_parameters:
        parameters.append(jsonlib.Value.Object(members=[jsonlib.Member(key="name", value=jsonlib.Value.Text(value=parameter.name)), jsonlib.Member(key="in", value=jsonlib.Value.Text(value="query")), jsonlib.Member(key="required", value=jsonlib.Value.Boolean(value=parameter.required)), jsonlib.Member(key="schema", value=schema_json(parameter.schema))]))
    var request: jsonlib.Value? = null
    let request_schema = route.request_schema
    if request_schema != null:
        request = openapi_helpers.request_body(schema_json(request_schema))
    var response_schema_json: jsonlib.Value? = null
    let response_schema = route.response_schema
    if response_schema != null:
        response_schema_json = schema_json(response_schema)
    let response = openapi_helpers.response("Response", response_schema_json)
    return openapi_helpers.operation(route.summary, parameters.toList(), request, route.response_status.toString(), response)

# An HTTP application: add routes, then run(port). It handles one request at a
# time and serves GET /openapi.json (with title and version) and GET /docs
# itself; a non-empty cors_origin adds CORS headers and answers OPTIONS.
class App:
    let title: String
    let version: String = "1.0.0"
    let cors_origin: String = ""
    let routes: MutableList[Route] = []
    var server: HostServer? = null

    # Adds a route; the first registered match wins. Throws Error for a path not
    # starting with "/", /openapi.json or /docs, a repeated method and path, a bad
    # or repeated {name}, renamed {name}s on an equivalent path or bad metadata.
    func route(route: Route) -> Unit throws Error:
        if not strings.starts_with(route.path, "/"):
            throw Error("route path must begin with /")
        if route.path == "/openapi.json" or route.path == "/docs":
            throw Error("reserved documentation route")
        let shape = template_shape(route.path)
        for previous in routes:
            if previous.path == route.path and previous.method == route.method:
                throw Error("duplicate route")
            if previous.path != route.path and template_shape(previous.path) == shape:
                throw Error("equivalent templated paths must use identical parameter names")
        let names: MutableList[String] = []
        for segment in strings.split(route.path, "/"):
            let name = parameter_name(segment)
            if name != null:
                if names.contains(name):
                    throw Error("duplicate path parameter")
                names.append(name)
            elif strings.starts_with(segment, "{") or strings.ends_with(segment, "}"):
                throw Error("path parameter must occupy one segment: {name}")
        let query_names: MutableList[String] = []
        for parameter in route.query_parameters:
            if query_names.contains(parameter.name):
                throw Error("duplicate query parameter metadata: " + parameter.name)
            query_names.append(parameter.name)
        if route.response_status < 200 or route.response_status > 599:
            throw Error("response metadata status must be 200..599")
        # Validate schema metadata before server startup; this is not body validation.
        jsonlib.stringify(operation_json(route))
        routes.append(route)

    # Adds a GET route without OpenAPI metadata; throws Error as route() does.
    func get(path: String, handler: fn(Request) -> Response throws Error) -> Unit throws Error:
        route(Route(method=Method.GET, path=path, handler=handler))

    # Adds a POST route without OpenAPI metadata; throws Error as route() does.
    func post(path: String, handler: fn(Request) -> Response throws Error) -> Unit throws Error:
        route(Route(method=Method.POST, path=path, handler=handler))

    # Adds a PUT route without OpenAPI metadata; throws Error as route() does.
    func put(path: String, handler: fn(Request) -> Response throws Error) -> Unit throws Error:
        route(Route(method=Method.PUT, path=path, handler=handler))

    # Adds a PATCH route without OpenAPI metadata; throws Error as route() does.
    func patch(path: String, handler: fn(Request) -> Response throws Error) -> Unit throws Error:
        route(Route(method=Method.PATCH, path=path, handler=handler))

    # Adds a DELETE route without OpenAPI metadata; throws Error as route()
    # does.
    func delete(path: String, handler: fn(Request) -> Response throws Error) -> Unit throws Error:
        route(Route(method=Method.DELETE, path=path, handler=handler))

    # The OpenAPI 3.0.3 document GET /openapi.json serves, built from the routes
    # added so far; routes on one path share a path item. Throws Error only for
    # an ARRAY schema without items, which route() already rejects.
    func openapi() -> jsonlib.Value throws Error:
        let paths: MutableList[jsonlib.Member] = []
        let visited: MutableList[String] = []
        for route in routes:
            if not visited.contains(route.path):
                visited.append(route.path)
                let operations: MutableList[jsonlib.Member] = []
                for candidate in routes:
                    if candidate.path == route.path:
                        operations.append(jsonlib.Member(key=operation_name(candidate.method), value=operation_json(candidate)))
                paths.append(jsonlib.Member(key=route.path, value=jsonlib.Value.Object(members=operations.toList())))
        return openapi_helpers.document(title, version, jsonlib.Value.Object(members=paths.toList()))

    # Internal: answers one host request (CORS preflight, the built-in paths,
    # then the routes in order, else 404) and lets failures escape; dispatch()
    # wraps it for the server that run(port) starts.
    func respond(raw: HostRequest) -> Response throws Error:
        let method = required(raw.method())
        let path = required(raw.rawPath())
        # Validate URI bytes before matching, including unmatched routes. The
        # query is decoded here, once, for every handler's Request.query.
        decode(path, false)
        let query_values = request_helpers.query_values(required(raw.rawQuery()))
        if method == "OPTIONS" and cors_origin != "":
            return text("", 204)
        if method == "GET" and path == "/openapi.json":
            return json_response(openapi(), 200)
        if method == "GET" and path == "/docs":
            return Response(status=200, content_type="text/html; charset=utf-8", body="<!doctype html><html><head><meta charset=\"utf-8\"><title>Sprig API</title><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui.css\"></head><body><div id=\"swagger-ui\"></div><script src=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui-bundle.js\"></script><script>SwaggerUIBundle({url:'/openapi.json',dom_id:'#swagger-ui'});</script></body></html>")
        for route in routes:
            if method_name(route.method) == method:
                match match_path(route.path, path):
                    case MatchResult.Missing:
                        pass
                    case MatchResult.Matched as matched:
                        let request = Request(method=method, path=decode(path, false), body=required(raw.body()), raw=raw, parameters=matched.parameters, query_values=query_values)
                        return route.handler(request)
        return text("Not found", 404)

    # Internal: the server's request callback: respond(), with BadRequest as 400
    # and other failures as 500, plus the CORS headers. Start serving with
    # run(port) or run_on(host, port).
    func dispatch(raw: HostRequest) -> HostResponse:
        var response = text("Internal server error", 500)
        try:
            response = respond(raw)
        catch problem: BadRequest:
            response = text("Bad request", 400)
        catch problem: Error:
            response = text("Internal server error", 500)
        catch problem: RuntimeException:
            response = text("Internal server error", 500)
        if cors_origin != "":
            response = response.with_header("Access-Control-Allow-Origin", cors_origin)
            response = response.with_header("Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
            response = response.with_header("Access-Control-Allow-Headers", "Content-Type")
            response = response.with_header("Vary", "Origin")
        let host = HostResponse(response.status, response.body, response.content_type)
        for header in response.headers:
            host.header(header.name, header.value)
        return host

    # Binds 127.0.0.1; port 0 asks the OS for a free one (see port()).
    func run(port: Int) -> Unit throws Error:
        run_on("127.0.0.1", port)

    # Binds a host name or address: "0.0.0.0" listens on every interface, for a
    # container or a machine that other hosts reach. There is no TLS; put a
    # reverse proxy in front for that.
    func run_on(host: String, port: Int) -> Unit throws Error:
        if server != null:
            throw Error("server already started")
        if host.trim().length() == 0:
            throw Error("host must not be blank")
        if port < 0 or port > 65535:
            throw Error("port must be 0..65535, got " + port)
        server = HostServer(host, port, fn(raw: HostRequest) => dispatch(raw))

    # The port the running server listens on, which is how to learn the one
    # run(0) picked. Throws Error when the server is not running.
    func port() -> Int throws Error:
        let active = server
        if active != null:
            return active.port()
        throw Error("server is not running")

    # Stops the server; does nothing when it is not running. The App keeps its
    # routes and can run again.
    func stop() -> Unit:
        let active = server
        if active != null:
            active.stop()
            server = null
