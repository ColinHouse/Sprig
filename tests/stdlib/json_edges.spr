import "@std/json.spr" as json

func rejected(source: String) -> Bool:
    try:
        json.parse(source)
    catch problem: Error:
        return true
    return false

let invalid: List[String] = ["", "-", "+1", "1.", "1e", "1e+", "[", "[1,]", "{\"x\":}", "{\"x\":1,}", "{\"x\":1,\"x\":2}", "\"\\q\"", "\"\\u0x00\"", "\"unterminated", "\"raw\nnewline\"", "true false", "01", "NaN", "nullx"]
var failures: Int = 0
for source in invalid:
    if rejected(source):
        failures += 1
    else:
        throw Error("accepted invalid JSON: " + source)
print("invalid JSON rejected=" + failures.toString())

print(json.stringify(json.parse("[-0,0.0,1E+2,-9223372036854775809]")))
print(json.stringify(json.parse("\"\\b\\f\\t\\r\\n\\u0000\\/\\\\\\\"\"")))
var deep = "null"
var level: Int = 0
while level < 129:
    deep = "[" + deep + "]"
    level += 1
print(rejected(deep))

# Parsing and serialization allow 128 container levels and reject level 129.
var at128 = "null"
level = 0
while level < 128:
    at128 = "[" + at128 + "]"
    level += 1
json.parse(at128)
let rendered128 = json.stringify(json.parse(at128))
if rendered128 != at128:
    throw Error("JSON depth-128 parse/stringify changed the input")
print("parse depth 128 accepted=" + level.toString())
print("depth-128 output length=" + rendered128.length().toString())
print("parse depth 129 rejected=" + rejected("[" + at128 + "]").toString())

var nested: json.Value = json.Value.Null
level = 0
while level < 128:
    nested = json.Value.Array(values=[nested])
    level += 1
let serialized128 = json.stringify(nested)
print("serialize depth 128 accepted=" + serialized128.length().toString())
var serialize129Rejected = false
try:
    json.stringify(json.Value.Array(values=[nested]))
catch problem: Error:
    serialize129Rejected = true
print("serialize depth 129 rejected=" + serialize129Rejected.toString())

let supplementary = json.stringify(json.parse("\"\\uD83D\\uDE00\""))
print("supplementary pair=" + supplementary)
var escapedDuplicateRejected = false
try:
    json.parse("{\"a\":1,\"\\u0061\":2}")
catch problem: Error:
    escapedDuplicateRejected = true
print("escaped duplicate rejected=" + escapedDuplicateRejected.toString())
print("large exponent=" + json.stringify(json.parse("1e9999")))

var number_rejected = false
try:
    json.stringify(json.Value.Number(text="01"))
catch problem: Error:
    number_rejected = true
if not number_rejected:
    throw Error("serializer accepted invalid number")
print("serializer rejected invalid number")
let members: List[json.Member] = [json.Member(key="x", value=json.Value.Null), json.Member(key="x", value=json.Value.Null)]
var object_rejected = false
try:
    json.stringify(json.Value.Object(members=members))
catch problem: Error:
    object_rejected = true
if not object_rejected:
    throw Error("serializer accepted duplicate keys")
print("serializer rejected duplicate keys")

# A token cut short by the end of the text, or a different token, is an Error
# at the token's code point offset; a token that ends exactly at the end of the
# text is read. The source with 東 needs UTF-16, so offsets count code points.
func token_error(source: String) -> String:
    try:
        return "parsed " + json.stringify(json.parse(source))
    catch problem: Error:
        return problem.message

for source in ["tru", "[nul", "{\"a\":fals", "[true", "{\"a\"", "{\"a\":1", "[\"東\",tru", "trux", "[1}", "true", "[null]", "{\"東\":false}"]:
    print(token_error(source))
