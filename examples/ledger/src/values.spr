# Explicit JSON validation: absence, null and wrong kinds are different cases.
import "@std/json.spr" as json
import java.time.LocalDate as LocalDate
import java.time.format.DateTimeParseException as DateTimeParseException

func member(value: json.Value, key: String) -> json.Value throws Error:
    match json.find_member(value, key):
        case json.Lookup.Found as found:
            return found.value
        case json.Lookup.Missing:
            throw Error("Missing field: " + key)
        case json.Lookup.NotObject:
            throw Error("Expected JSON object")

func string_field(value: json.Value, key: String) -> String throws Error:
    match member(value, key):
        case json.Value.Text as text:
            return text.value
        case json.Value.Null:
            throw Error("Field cannot be null: " + key)
        case json.Value.Boolean:
            throw Error("Expected string: " + key)
        case json.Value.Number:
            throw Error("Expected string: " + key)
        case json.Value.Array:
            throw Error("Expected string: " + key)
        case json.Value.Object:
            throw Error("Expected string: " + key)

func integer_field(value: json.Value, key: String) -> Int throws Error:
    match member(value, key):
        case json.Value.Number as number:
            let integer = number.text.toIntOrNull()
            if integer != null:
                return integer
            throw Error("Expected exact signed 64-bit integer: " + key)
        case json.Value.Null:
            throw Error("Field cannot be null: " + key)
        case json.Value.Boolean:
            throw Error("Expected integer: " + key)
        case json.Value.Text:
            throw Error("Expected integer: " + key)
        case json.Value.Array:
            throw Error("Expected integer: " + key)
        case json.Value.Object:
            throw Error("Expected integer: " + key)

func valid_date(value: String) -> Bool:
    if value.length() != 10:
        return false
    try:
        return LocalDate.parse(value) != null
    catch problem: DateTimeParseException:
        return false

func number(value: Int) -> json.Value:
    return json.Value.Number(text=value.toString())

func text(value: String) -> json.Value:
    return json.Value.Text(value=value)
