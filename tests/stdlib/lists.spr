import java.lang.Double as Double
import "@std/lists.spr" as lists

class Order:
    let item: String
    let category: String
    let cents: Int

let orders: List[Order] = [
    Order(item="tea", category="drink", cents=300),
    Order(item="cake", category="food", cents=450),
    Order(item="coffee", category="drink", cents=350),
    Order(item="bread", category="food", cents=200),
    Order(item="water", category="drink", cents=100),
]

for order in lists.sort_by[Order, Int](orders, fn(o: Order) => o.cents):
    print(order.item)

for order in lists.sort_by[Order, String](orders, fn(o: Order) => o.category):
    print(order.item)

for group in lists.group_by[Order, String](orders, fn(o: Order) => o.category):
    let total = lists.fold[Order, Int](group.items, 0, fn(sum: Int, o: Order) => sum + o.cents)
    print(group.key + " " + group.items.size().toString() + " " + total.toString())

let floats: List[Float] = [2.5, Double.NaN, 0.0, -0.0, 1.0]
print(lists.sort_by[Float, Float](floats, fn(x: Float) => x))

let float_groups = lists.group_by[Float, Float]([Double.NaN, 0.0, Double.NaN, -0.0], fn(x: Float) => x)
print(float_groups.size())
for group in float_groups:
    print("" + group.key + " " + group.items.size().toString())

let empty: List[Order] = []
print(lists.sort_by[Order, Int](empty, fn(o: Order) => o.cents).size())
print(lists.group_by[Order, String](empty, fn(o: Order) => o.category).size())
print(lists.fold[Int, Int]([1, 2, 3], 10, fn(total: Int, x: Int) => total + x))

# Counts how often a test or a key ran, to show where a search stops and how
# often a key is computed.
class Probe:
    var calls: Int = 0

    func over(limit: Int, value: Int) -> Bool:
        calls += 1
        return value > limit

    func key(value: Int) -> Int:
        calls += 1
        return value

let cheap = lists.find[Order](orders, fn(o: Order) => o.cents < 250)
if cheap != null:
    print(cheap.item)
print(lists.find[Order](orders, fn(o: Order) => o.cents > 1000) == null)
let found = Probe()
print(lists.find[Int]([1, 5, 9, 12], fn(n: Int) => found.over(4, n)))
print(found.calls)

print(lists.any[Order](orders, fn(o: Order) => o.category == "food"))
print(lists.any[Order](orders, fn(o: Order) => o.cents > 1000))
print(lists.any[Order](empty, fn(o: Order) => true))
let some = Probe()
print(lists.any[Int]([1, 5, 9, 12], fn(n: Int) => some.over(4, n)))
print(some.calls)

print(lists.all[Order](orders, fn(o: Order) => o.cents >= 100))
print(lists.all[Order](orders, fn(o: Order) => o.category == "drink"))
print(lists.all[Order](empty, fn(o: Order) => false))
let every = Probe()
print(lists.all[Int]([5, 1, 9, 12], fn(n: Int) => every.over(4, n)))
print(every.calls)

print(lists.count[Order](orders, fn(o: Order) => o.category == "drink"))
print(lists.count[Order](empty, fn(o: Order) => true))
print(lists.sum([1, 2, 3]))
let none: List[Int] = []
print(lists.sum(none))
print(lists.sum_by[Order](orders, fn(o: Order) => o.cents))
print(lists.sum_by[Order](empty, fn(o: Order) => o.cents))

let names: List[String] = ["pear", "apple", "fig", "apple"]
print(lists.sorted[String](names))
print(names)
print(lists.sorted[Float](floats))
print(lists.sorted[Int](none).size())

# The helpers are rethrows: a lambda that calls a throwing function makes the
# call throw, and nothing else changes.
func cents_of(text: String) -> Int throws Error:
    let value = text.toIntOrNull()
    if value != null:
        return value
    throw Error("not a number: " + text)

let prices: List[String] = ["300", "450", "100"]
try:
    print(lists.sum_by[String](prices, fn(p: String) => cents_of(p)))
    print(lists.count[String](prices, fn(p: String) => cents_of(p) > 200))
    print(lists.sort_by[String, Int](prices, fn(p: String) => cents_of(p)))
    print(lists.fold[String, Int](prices, 0, fn(total: Int, p: String) => total + cents_of(p)))
    print(lists.find[String](prices, fn(p: String) => cents_of(p) < 200))
    print(lists.any[String](["1", "x"], fn(p: String) => cents_of(p) > 0))
    print(lists.all[String](["1", "x"], fn(p: String) => cents_of(p) > 0))
catch problem: Error:
    print("caught " + problem)

# max and min: null for an empty list, the order of sorted (NaN is the largest
# Float, -0.0 is below 0.0), and the first of several equal items
print(lists.max([3, 9, 2, 9]))
print(lists.min([3, 9, 2, 9]))
print(lists.max(names))
print(lists.min(names))
print(lists.max(none) == null and lists.min(none) == null)
print(lists.max(floats))
print(lists.min(floats))
print(lists.max([0.0, -0.0]))
print(lists.min([0.0, -0.0]))
let amounts = [Decimal.parse("2.50"), Decimal.parse("1"), Decimal.parse("2.5"), Decimal.parse("1.0")]
print(lists.max(amounts))
print(lists.min(amounts))

# max_by and min_by: the item with the largest or smallest key; of equal keys
# the first wins; one key per item; null for an empty list; rethrows
let priciest = lists.max_by(orders, fn(o: Order) => o.cents)
let cheapest = lists.min_by(orders, fn(o: Order) => o.cents)
if priciest != null and cheapest != null:
    print(priciest.item + " " + cheapest.item)
let food = lists.max_by(orders, fn(o: Order) => o.category)
let drink = lists.min_by(orders, fn(o: Order) => o.category)
if food != null and drink != null:
    print(food.item + " " + drink.item)
print(lists.max_by(empty, fn(o: Order) => o.cents) == null and lists.min_by(empty, fn(o: Order) => o.cents) == null)
let keyed = Probe()
print(lists.max_by([4, 12, 9], fn(n: Int) => keyed.key(n)))
print(keyed.calls)
print(lists.min_by(floats, fn(x: Float) => x))
try:
    print(lists.max_by(prices, fn(p: String) => cents_of(p)))
    print(lists.min_by(["1", "x", "2"], fn(p: String) => cents_of(p)))
catch problem: Error:
    print("caught " + problem)
