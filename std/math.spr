# Exact 64-bit integer arithmetic helpers. No Float/Decimal overloads exist.
func abs(value: Int) -> Int:
    if value < 0:
        return 0 - value
    return value

func min(left: Int, right: Int) -> Int:
    if left < right:
        return left
    return right

func max(left: Int, right: Int) -> Int:
    if left > right:
        return left
    return right

func sign(value: Int) -> Int:
    if value < 0:
        return 0 - 1
    if value > 0:
        return 1
    return 0

func clamp(value: Int, low: Int, high: Int) -> Int throws Error:
    if low > high:
        throw Error("clamp lower bound must not exceed upper bound")
    if value < low:
        return low
    if value > high:
        return high
    return value

# Sprig's division family truncates toward zero; this floors toward negative
# infinity for either divisor sign and rejects a zero divisor.
func floor_div(value: Int, divisor: Int) -> Int throws Error:
    if divisor == 0:
        throw Error("floor_div divisor must not be zero")
    var quotient = value.divTrunc(divisor)
    if value - quotient * divisor != 0:
        if (value < 0) != (divisor < 0):
            quotient -= 1
    return quotient

# Floor of the real square root; negative inputs are rejected, not clamped.
func isqrt(value: Int) -> Int throws Error:
    if value < 0:
        throw Error("isqrt input must not be negative")
    if value < 2:
        return value
    var current = value
    var next = (current + 1).divTrunc(2)
    while next < current:
        current = next
        next = (current + value.divTrunc(current)).divTrunc(2)
    return current
