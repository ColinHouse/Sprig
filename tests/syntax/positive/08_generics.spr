generic T:
    class Box:
        let value: T

generic T:
    func identity(value: T) -> T:
        return value

generic T:
    variant Option:
        Some:
            value: T
        None:

let box: Box[Int] = Box[Int](value=1)
print(identity[Int](box.value))
let empty: Option[String] = Option[String].None

generic K, V:
    class Entry:
        let key: K
        let value: V

let entry: Entry[String, Int] = Entry[String, Int](key="age", value=18)
