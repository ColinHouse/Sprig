import java.util.Random as Random

# Counting extends java.util.Random: the seed field goes to the Random(long) constructor,
# overrides protected next(bits) and calls the inherited implementation as parent.
class Counting:
    let seed: Int
    var calls: Int = 0

    func next(bits: Int32) -> Int32:
        calls += 1
        return parent.next(bits)

conform Counting to Random(seed) as parent

let rng = Counting(seed=42)
print(rng.nextInt(100))
print(rng.nextInt(100))
print(rng.calls)
let plain: Random = rng
print(plain.nextInt(100))
print(rng.calls)
