generic T:
    class Box:
        var value: T
let b = Box[Int](value=1)
var calls: Int = 0
let holders: List[Box[Int]] = [b]
func target() -> Int:
    calls += 1
    return 0
let n: Int32 = 7
holders[target()].value += n
print(b.value)
print(calls)
b.value *= n
print(b.value)
b.value -= n
print(b.value)
let f: Float32 = 1.5
let fb = Box[Float](value=2.0)
fb.value += f
print(fb.value)
