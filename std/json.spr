# Closed recursive JSON. Numbers retain exact validated lexemes, never Float.
# Reading fields with paths and kind checks is the job of @std/json_codec.spr,
# so a program does not match every Value case itself:
#     codec.required_int(codec.root(json.parse(text)), "id")
# returns the Int or throws an Error that starts with the path, such as
# "$.id: expected integer, found string".
import java.lang.StringBuilder as StringBuilder
import sprig.runtime.host.HostText as HostText

# A JSON value. Number holds the number's exact text, such as 12.50 or -2e3,
# never a Float; Object holds its members in order, and keys must be unique.
# stringify checks both for a hand-built value.
variant Value:
    Null
    Boolean(value: Bool)
    Number(text: String)
    Text(value: String)
    Array(values: List[Value])
    Object(members: List[Member])

# Explicit lookup: a present JSON Null is Found(value=Value.Null).
variant Lookup:
    Missing
    Found(value: Value)
    NotObject

# One key and its value in a JSON Object. A key may appear once per object:
# parse, stringify and find_member reject a repeated one.
class Member:
    let key: String
    let value: Value

# Validate the complete object before returning, including duplicates after a match.
# To read typed fields with paths and kind checks, use "@std/json_codec.spr".
func find_member(value: Value, key: String) -> Lookup throws Error:
    match value:
        case Value.Null:
            return Lookup.NotObject
        case Value.Boolean as node:
            return Lookup.NotObject
        case Value.Number as node:
            return Lookup.NotObject
        case Value.Text as node:
            return Lookup.NotObject
        case Value.Array as node:
            return Lookup.NotObject
        case Value.Object as node:
            let keys: MutableList[String] = []
            var result: Lookup = Lookup.Missing
            for member in node.members:
                if keys.contains(member.key):
                    throw Error("duplicate object key: " + member.key)
                keys.append(member.key)
                if member.key == key:
                    result = Lookup.Found(value=member.value)
            return result

# Internal: the single UTF-16 code unit a hex string such as "000c" names, for
# the parser's \b and \f escapes; callers use parse.
func unicode_unit(hex: String) -> String throws Error:
    let value = HostText.unicodeUnit(hex)
    if value != null:
        return value
    throw Error("host unicode conversion returned null")

# Internal: whether a one-character string is an ASCII digit, for the parser;
# callers use text.is_ascii_digit.
func digit(ch: String) -> Bool:
    return ch >= "0" and ch <= "9"

# Internal: whether a one-character string is a hex digit (0-9, a-f, A-F), for
# the parser's \u escapes; callers use parse.
func hex_digit(ch: String) -> Bool:
    return digit(ch) or (ch >= "a" and ch <= "f") or (ch >= "A" and ch <= "F")

# Internal: the cursor parse reads with, a source text and a code point offset;
# stringify also uses it to check Number text. Callers use parse.
class Reader:
    let source: String
    var offset: Int = 0

    # Internal: always throws Error("JSON at code point offset N: message").
    func fail(message: String) -> Unit throws Error:
        throw Error("JSON at code point offset " + offset.toString() + ": " + message)

    # Internal: the code point at the offset as a string, or "" at the end.
    func current() -> String:
        if offset >= source.length():
            return ""
        return source.charAt(offset)

    # Internal: skips spaces, tabs, carriage returns and line feeds.
    func whitespace() -> Unit:
        while current() == " " or current() == "\t" or current() == "\r" or current() == "\n":
            offset += 1

    # Internal: consumes the token at the offset, or fails with
    # "expected <token>".
    func expect(token: String) -> Unit throws Error:
        if offset + token.length() > source.length():
            fail("expected " + token)
        if source.substring(offset, offset + token.length()) != token:
            fail("expected " + token)
        offset += token.length()

    # Internal: reads the quoted JSON string at the offset and returns its
    # decoded text; a missing quote, a raw control character or an invalid
    # escape is an Error.
    func string_value() -> String throws Error:
        expect("\"")
        let value = StringBuilder()
        while current() != "\"":
            let ch = current()
            if ch == "":
                fail("unterminated string")
            if HostText.isControl(ch):
                fail("unescaped control character")
            offset += 1
            if ch == "\\":
                let escape = current()
                offset += 1
                if escape == "\"" or escape == "\\" or escape == "/":
                    value.append(escape)
                elif escape == "b":
                    value.append(unicode_unit("0008"))
                elif escape == "f":
                    value.append(unicode_unit("000c"))
                elif escape == "n":
                    value.append("\n")
                elif escape == "r":
                    value.append("\r")
                elif escape == "t":
                    value.append("\t")
                elif escape == "u":
                    var hex = ""
                    var count: Int = 0
                    while count < 4:
                        if not hex_digit(current()) or current() == "":
                            fail("invalid unicode escape")
                        hex += current()
                        offset += 1
                        count += 1
                    let unit = HostText.unicodeUnit(hex)
                    if unit != null:
                        value.append(unit)
                    else:
                        fail("host unicode conversion returned null")
                else:
                    fail("invalid escape")
            else:
                value.append(ch)
        offset += 1
        return value.toString()

    # Internal: reads the JSON number at the offset and returns its exact text,
    # failing on a leading zero or missing digits; what follows is not checked.
    func number_value() -> String throws Error:
        let start = offset
        if current() == "-":
            offset += 1
        if current() == "0":
            offset += 1
            if digit(current()):
                fail("leading zero")
        elif current() >= "1" and current() <= "9":
            while digit(current()):
                offset += 1
        else:
            fail("expected number")
        if current() == ".":
            offset += 1
            if not digit(current()):
                fail("expected fraction digits")
            while digit(current()):
                offset += 1
        if current() == "e" or current() == "E":
            offset += 1
            if current() == "+" or current() == "-":
                offset += 1
            if not digit(current()):
                fail("expected exponent digits")
            while digit(current()):
                offset += 1
        return source.substring(start, offset)

    # Internal: skips whitespace and reads one JSON value; depth counts the
    # enclosing arrays and objects, and more than 128 is an Error.
    func value(depth: Int) -> Value throws Error:
        if depth > 128:
            fail("nesting exceeds 128")
        whitespace()
        let ch = current()
        if ch == "n":
            expect("null")
            return Value.Null
        if ch == "t":
            expect("true")
            return Value.Boolean(value=true)
        if ch == "f":
            expect("false")
            return Value.Boolean(value=false)
        if ch == "\"":
            return Value.Text(value=string_value())
        if ch == "[":
            return array(depth)
        if ch == "{":
            return object(depth)
        if ch == "-" or digit(ch):
            return Value.Number(text=number_value())
        fail("expected JSON value")
        return Value.Null

    # Internal: reads the "[...]" array at the offset, its items one level
    # deeper; a trailing comma is an Error.
    func array(depth: Int) -> Value throws Error:
        expect("[")
        whitespace()
        let values: MutableList[Value] = []
        if current() != "]":
            values.append(value(depth + 1))
            whitespace()
            while current() == ",":
                offset += 1
                values.append(value(depth + 1))
                whitespace()
        expect("]")
        return Value.Array(values=values.toList())

    # Internal: reads the "{...}" object at the offset, its values one level
    # deeper; a duplicate key or a trailing comma is an Error.
    func object(depth: Int) -> Value throws Error:
        expect("{")
        whitespace()
        let members: MutableList[Member] = []
        let keys: MutableList[String] = []
        if current() != "}":
            var more = true
            while more:
                whitespace()
                let key = string_value()
                if keys.contains(key):
                    fail("duplicate object key: " + key)
                keys.append(key)
                whitespace()
                expect(":")
                members.append(Member(key=key, value=value(depth + 1)))
                whitespace()
                more = current() == ","
                if more:
                    offset += 1
        expect("}")
        return Value.Object(members=members.toList())

# The JSON value the text holds, with optional whitespace around it. Invalid
# JSON, text after the value, a duplicate key or nesting deeper than 128 is an
# Error naming the code point offset. Numbers keep their exact text.
func parse(source: String) -> Value throws Error:
    let reader = Reader(source=source)
    let value = reader.value(0)
    reader.whitespace()
    if reader.offset != source.length():
        reader.fail("trailing text")
    return value

# The text as a JSON string literal in double quotes. " and \ are escaped, line
# feed, carriage return and tab become \n, \r and \t, and other control
# characters \u00xx; everything else, non-ASCII included, is kept as it is.
func quote(value: String) -> String throws Error:
    let result = StringBuilder()
    result.append("\"")
    var index: Int = 0
    while index < value.length():
        let ch = value.charAt(index)
        if ch == "\"" or ch == "\\":
            result.append("\\")
            result.append(ch)
        elif ch == "\n":
            result.append("\\n")
        elif ch == "\r":
            result.append("\\r")
        elif ch == "\t":
            result.append("\\t")
        elif HostText.isControl(ch):
            let escaped = HostText.controlEscape(ch)
            if escaped != null:
                result.append(escaped)
            else:
                throw Error("host control escape returned null")
        else:
            result.append(ch)
        index += 1
    result.append("\"")
    return result.toString()

# Internal: stringify's recursive step, where depth counts the enclosing arrays
# and objects; callers use stringify.
func render(value: Value, depth: Int) -> String throws Error:
    let out = StringBuilder()
    render_into(out, value, depth)
    return out.toString()

# Internal: appends render's text for the value to out, so a whole document is
# built in one buffer; callers use stringify.
func render_into(out: StringBuilder, value: Value, depth: Int) -> Unit throws Error:
    if depth > 128:
        throw Error("JSON nesting exceeds 128")
    match value:
        case Value.Null:
            out.append("null")
        case Value.Boolean as node:
            if node.value:
                out.append("true")
            else:
                out.append("false")
        case Value.Number as node:
            let reader = Reader(source=node.text)
            reader.number_value()
            if reader.offset != node.text.length():
                reader.fail("invalid number lexeme")
            out.append(node.text)
        case Value.Text as node:
            out.append(quote(node.value))
        case Value.Array as node:
            out.append("[")
            var first = true
            for child in node.values:
                if not first:
                    out.append(",")
                first = false
                render_into(out, child, depth + 1)
            out.append("]")
        case Value.Object as node:
            out.append("{")
            let keys: MutableMap[String, Bool] = {}
            var first = true
            for member in node.members:
                if keys.containsKey(member.key):
                    throw Error("duplicate object key: " + member.key)
                keys.set(member.key, true)
                if not first:
                    out.append(",")
                first = false
                out.append(quote(member.key))
                out.append(":")
                render_into(out, member.value, depth + 1)
            out.append("}")

# Compact JSON text for the value, with no spaces and members in their stored
# order. An Error for a Number whose text is not a valid JSON number, a
# duplicate key in an Object, or nesting deeper than 128.
func stringify(value: Value) -> String throws Error:
    return render(value, 0)
