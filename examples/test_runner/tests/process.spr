import "@std/test.spr" as testing

let version = testing.run_process(["java", "--version"])
assert(version.exit_code == 0)
assert(version.stdout.length() > 0)
assert(version.stderr == "")

# English launcher text keeps stderr valid UTF-8 on every system locale.
let missing = testing.run_process(["java", "-Duser.language=en", "no.such.SprigTestClass"])
assert(missing.exit_code != 0)
assert(missing.stderr.length() > 0)
