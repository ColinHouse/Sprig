# Cancellation and failure accounting of @std/concurrent scopes. Every case
# must end: a task that is cancelled, or dropped by a pool, before its body
# ever ran used to keep its scope waiting forever. A single-thread pool keeps
# a task queued for certain, so each case is deterministic.
import "@std/concurrent.spr" as concurrent

func divide(a: Int, b: Int) -> Int:
    return a.divTrunc(b)

# 1. a failed task's await() reports its own failure, not a cancellation
func own_failure(s: concurrent.Scope) -> Int throws Error:
    let failing = concurrent.spawn(s, fn() => divide(1, 0))
    try:
        return failing.await()
    catch problem: Error:
        print("await reports the failure: " + problem.message.contains("zero"))
        return -1
try:
    print(concurrent.scope(own_failure))
catch problem: Error:
    print("scope reports the failure: " + problem.message.contains("zero"))

# 2. a task cancelled while it waits in a pool's queue never runs, and its
# scope still ends
let ran = concurrent.counter(0)
let release = concurrent.counter(0)
let one = concurrent.pool(1)
func blocker() -> Int:
    while release.get() == 0:
        concurrent.sleep(5)
    return 1
func queued() -> Int:
    ran.increment()
    return 2
func cancel_queued(s: concurrent.Scope) -> Int throws Error:
    let holding = concurrent.spawn_on(s, one, fn() => blocker())
    let waiting = concurrent.spawn_on(s, one, fn() => queued())
    print("queued task cancelled: " + waiting.cancel())
    release.set(1)
    return holding.await() * 10 + ran.get()
print(concurrent.scope(cancel_queued))

# 3. the first failure cancels siblings that are still queued; they never
# run, and the scope ends with that failure
let go = concurrent.counter(0)
let two = concurrent.pool(1)
func fail_when_told() -> Int:
    while go.get() == 0:
        concurrent.sleep(5)
    return divide(1, 0)
func failure_cancels_queue(s: concurrent.Scope) -> Int throws Error:
    concurrent.spawn_on(s, two, fn() => fail_when_told())
    concurrent.spawn_on(s, two, fn() => queued())
    concurrent.spawn_on(s, two, fn() => queued())
    go.set(1)
    return 0
try:
    print(concurrent.scope(failure_cancels_queue))
catch problem: Error:
    print("queued siblings never ran: " + problem.message.contains("zero") + " " + ran.get())

# 4. a pool's shutdown_now drops its queued tasks, and the scope does not
# wait for tasks that will never run; the running task is cancelled too
let held = concurrent.counter(0)
let stop = concurrent.counter(0)
let three = concurrent.pool(1)
func spin_until_stopped() -> Int:
    held.increment()
    while stop.get() == 0:
        pass
    return 1
func shutdown_drops_queue(s: concurrent.Scope) -> Int throws Error:
    let holding = concurrent.spawn_on(s, three, fn() => spin_until_stopped())
    let dropped = concurrent.spawn_on(s, three, fn() => queued())
    while held.get() == 0:
        concurrent.sleep(5)
    three.shutdown_now()
    stop.set(1)
    print("dropped task cancelled: " + dropped.is_cancelled())
    print("running task cancelled: " + holding.is_cancelled())
    return ran.get()
print(concurrent.scope(shutdown_drops_queue))

# 5. a body that fails only because it awaited a task the first failure
# cancelled reports that first failure, not the cancellation (#205)
let waiter_started = concurrent.counter(0)
let never = concurrent.counter(0)
func wait_until_cancelled() -> Int:
    waiter_started.set(1)
    while never.get() == 0:
        concurrent.sleep(5)
    return 0
func fail_after_waiter() -> Int:
    while waiter_started.get() == 0:
        concurrent.sleep(5)
    return divide(1, 0)
func await_cancelled_sibling(s: concurrent.Scope) -> Int throws Error:
    let waiting = concurrent.spawn(s, fn() => wait_until_cancelled())
    let failing = concurrent.spawn(s, fn() => fail_after_waiter())
    return waiting.await() + failing.await()
try:
    print(concurrent.scope(await_cancelled_sibling))
catch problem: Error:
    print("the first failure, not the cancellation: " + problem.message.contains("zero"))

# 6. an error of the body's own is reported as it is
func own_error(s: concurrent.Scope) -> Int throws Error:
    concurrent.spawn(s, fn() => divide(1, 0))
    throw Error("the body gave up")
try:
    print(concurrent.scope(own_error))
catch problem: Error:
    print("the body's own error is kept: " + (problem.message == "the body gave up"))

# 7. shutdown_now cancels the pool's running tasks too: a task asleep when its
# pool shuts down ends as cancelled, which is not a failure of its scope
let asleep = concurrent.latch(1)
let four = concurrent.pool(1)
func sleep_on_pool() -> Int:
    asleep.count_down()
    concurrent.sleep(60000)
    return 1
func shutdown_cancels_running(s: concurrent.Scope) -> Int throws Error:
    let running = concurrent.spawn_on(s, four, fn() => sleep_on_pool())
    asleep.await()
    four.shutdown_now()
    print("running task cancelled: " + running.is_cancelled())
    return running.await_or(-1)
try:
    print(concurrent.scope(shutdown_cancels_running))
catch problem: Error:
    print("the scope failed: " + problem.message)

# 8. a cancelled task is done at once, even while its body still runs, and
# its scope still waits for the body to end
let entered = concurrent.latch(1)
let let_go = concurrent.latch(1)
let body_ended = concurrent.counter(0)
func ignore_interrupts() -> Int:
    entered.count_down()
    while let_go.remaining() > 0:
        pass
    body_ended.set(1)
    return 1
func done_before_body_ends(s: concurrent.Scope) -> Int throws Error:
    let task = concurrent.spawn(s, fn() => ignore_interrupts())
    entered.await()
    print("cancelled: " + task.cancel())
    print("done at once: " + task.is_done() + ", body ended: " + body_ended.get())
    let_go.count_down()
    return 0
concurrent.scope(done_before_body_ends)
print("the scope waited for the body: " + body_ended.get())
