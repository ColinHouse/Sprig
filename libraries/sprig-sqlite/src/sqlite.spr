# SQL remains application code; JDBC only owns binding and resource lifetimes.
import sprig.runtime.sqlite.Database as HostDatabase
import sprig.runtime.sqlite.Parameters as HostParameters
import sprig.runtime.sqlite.Rows as HostRows
import sprig.runtime.sqlite.Batch as HostBatch

# A value for a ? placeholder, bound in list order: Integer (64-bit), Text,
# Boolean (stored as 0 or 1) or Null (SQL NULL, unlike "" and 0).
variant Parameter:
    Integer(value: Int)
    Text(value: String)
    Boolean(value: Bool)
    Null

# One SQL statement and the values for its ? placeholders, for Database.batch.
class Statement:
    let sql: String
    let parameters: List[Parameter]

# Internal: copies parameters into the JDBC host's builder; Database.execute,
# query and batch bind them for you.
func bind(values: List[Parameter]) -> HostParameters:
    let result = HostParameters()
    for value in values:
        match value:
            case Parameter.Integer as node:
                result.integer(node.value)
            case Parameter.Text as node:
                result.text(node.value)
            case Parameter.Boolean as node:
                result.bool(node.value)
            case Parameter.Null:
                result.nil()
    return result

# A query result copied into memory (at most 10,000 rows); it holds no
# connection. Rows count from 0, and column labels match ignoring case.
class Rows:
    let host: HostRows

    # How many rows the query returned.
    func size() -> Int:
        return host.size()

    # True when the value is SQL NULL. Throws Error for an unknown column or a
    # bad row.
    func is_null(row: Int, column: String) -> Bool throws Error:
        return host.isNull(row, column)

    # The value, which must be a non-null INTEGER. Throws Error for NULL, any
    # other kind of value (REAL and TEXT are not converted), an unknown column
    # or a bad row.
    func integer(row: Int, column: String) -> Int throws Error:
        return host.integer(row, column)

    # The value, which must be non-null TEXT. Throws Error for NULL, any other
    # kind of value (numbers are not converted), an unknown column or a bad row.
    func text(row: Int, column: String) -> String throws Error:
        let value = host.text(row, column)
        if value != null:
            return value
        throw Error("SQLite text unexpectedly returned null")

    # An INTEGER 0 or 1 as false or true. Throws Error for any other value,
    # NULL, an unknown column or a bad row.
    func boolean(row: Int, column: String) -> Bool throws Error:
        return host.bool(row, column)

# A SQLite database file; get one from open(path). Each call opens its own
# connection (foreign keys on), so no transaction spans calls. Each sql holds
# one statement: a trailing ";" or comment is fine, and a second statement
# throws Error and the call changes nothing. Bad SQL, a wrong ? count or
# BEGIN/COMMIT-style SQL also throws Error.
class Database:
    let path: String

    # Runs sql, one statement (a second one throws Error), and returns how many
    # rows it changed. A statement that returns rows, such as SELECT or
    # INSERT ... RETURNING, throws Error; use query for those.
    func execute(sql: String, parameters: List[Parameter]) -> Int throws Error:
        return HostDatabase(path).execute(sql, bind(parameters))

    # Runs sql, one SELECT or INSERT ... RETURNING statement (whose write then
    # commits), into Rows. A second statement throws Error; a BLOB value, a
    # repeated column label (alias it) or over 10,000 rows throws Error and
    # rolls back.
    func query(sql: String, parameters: List[Parameter]) -> Rows throws Error:
        let value = HostDatabase(path).query(sql, bind(parameters))
        if value != null:
            return Rows(host=value)
        throw Error("SQLite query unexpectedly returned null")

    # Runs the statements in order, in one transaction: all commit, or on Error
    # (a second statement in one sql included) all roll back. Returns the summed
    # change counts, where a schema statement after a write repeats that
    # write's count.
    func batch(statements: List[Statement]) -> Int throws Error:
        let batch = HostBatch()
        for statement in statements:
            batch.add(statement.sql, bind(statement.parameters))
        return HostDatabase(path).batch(batch)

    # Trusted migration SQL and its ledger entry share one batch transaction.
    func batch_script(sql: String, statements: List[Statement]) -> Int throws Error:
        let batch = HostBatch()
        batch.addScript(sql)
        for statement in statements:
            batch.add(statement.sql, bind(statement.parameters))
        return HostDatabase(path).batch(batch)

# Opens the SQLite file at path, creating it when missing, and checks that it
# connects. Throws Error for a blank path, ":memory:", a file: URI or a file
# that cannot be opened, such as one in a directory that does not exist.
func open(path: String) -> Database throws Error:
    HostDatabase(path).initialize()
    return Database(path=path)
