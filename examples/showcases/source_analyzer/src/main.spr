import "../../../../std/files.spr" as files
import "../../../../std/process.spr" as process
import "./frontend.spr" as frontend
import "./outline.spr" as outline
import java.io.IOException as IOException

func main() -> Unit throws IOException, Error:
    let args = process.arguments()
    if args.size() > 1:
        throw Error("usage: source-analyzer [source.spr]")
    var path = "fixtures/function.spr"
    if args.size() == 1:
        path = args.get(0)
    let reports = frontend.Reporter()
    let source = frontend.SourceText(path=path, text=files.read_utf8(path))
    let tokens = frontend.Lexer(source=source, reports=reports).tokenize()
    let statements = frontend.Parser(tokens=tokens, reports=reports).parse_program()
    frontend.SymbolChecker(reports=reports).program(statements)
    let summary = outline.Summary()
    summary.program(statements)
    print("Sprig subset source outline")
    print("statements=" + summary.statements.toString() + " expressions=" + summary.expressions.toString() + " functions=" + summary.functions.toString() + " bindings=" + summary.bindings.toString())
    for item in summary.outline:
        print(item)
    print("references=" + summary.references.toList().toString())
    print("diagnostics=" + reports.count().toString())
    for issue in reports.list():
        print(issue.describe())

try:
    main()
catch problem: IOException:
    print("IO error: " + problem.message)
    throw problem
catch problem: Error:
    print("Analysis error: " + problem.message)
    throw problem
