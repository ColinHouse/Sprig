# `for x in range(...)` is a counted loop: no list is built, the bounds are
# evaluated once from left to right, and each iteration has a fresh binding.
# It visits the same values as iterating the list that range(...) returns.

func counted(start: Int, end: Int, step: Int) -> List[Int]:
    let out: MutableList[Int] = []
    for x in range(start, end, step):
        out.append(x)
        if out.size() > 50:
            break
    return out.toList()

func listed(start: Int, end: Int, step: Int) -> List[Int]:
    let out: MutableList[Int] = []
    for x in range(start, end, step).toList():
        out.append(x)
        if out.size() > 50:
            break
    return out.toList()

let max = 9223372036854775807
let min = -9223372036854775807 - 1
let cases: List[List[Int]] = [[0, 5, 1], [5, 0, 1], [0, 5, 2], [0, 6, 2], [5, 0, -1], [5, 0, -2], [0, 0, 1], [0, 0, -1], [-3, 3, 1], [3, -3, -3], [max - 3, max, 1], [max - 3, max, 2], [max - 10, max, 7], [min + 3, min, -1], [min + 10, min, -7], [min, min + 3, 1], [max, min, -4611686018427387904], [min, max, 4611686018427387904], [max, min, min], [0, 1, max], [0, -1, min]]
var mismatches = 0
for c in cases:
    let a = counted(c[0], c[1], c[2])
    let b = listed(c[0], c[1], c[2])
    if a != b:
        print("mismatch " + c + ": " + a + " vs " + b)
        mismatches += 1
print("cases " + cases.size() + ", mismatches " + mismatches)
print(counted(max - 3, max, 1))
print(counted(5, 0, -2))

# A range far larger than memory starts at once.
var seen = 0
for i in range(4000000000000000000):
    if i == 3:
        break
    seen += 1
print("seen " + seen)

let actions: MutableList[fn() -> Int] = []
for i in range(3):
    actions.append(fn() => i * 10)
for action in actions:
    print(action())

let trace: MutableList[String] = []
func bound(label: String, value: Int) -> Int:
    trace.append(label)
    return value
var sum = 0
for v in range(bound("start", 1), bound("end", 10), bound("step", 3)):
    if v == 4:
        continue
    sum += v
print(trace)
print(sum)

for outer in range(2):
    for inner in range(outer, 3):
        print(outer + "," + inner)

try:
    for z in range(0, 5, 0):
        print(z)
catch problem: Error:
    print("caught: " + problem.message)
