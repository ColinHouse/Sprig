variant Category:
    Food
    Transport
    Other(label: String)

func describe(category: Category) -> String:
    return match category:
        case Category.Food:
            "food"
        case Category.Transport:
            "transport"
        case Category.Other as other:
            "other: " + other.label

print(describe(Category.Food))
print(describe(Category.Other(label="movie")))
