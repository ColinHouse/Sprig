import java.math.BigDecimal as BigDecimal
import java.math.RoundingMode as RoundingMode
# String position operations use Unicode code points; Java char interop remains UTF-16.

# The values with the separator between each pair; an empty list gives "".
func join(values: List[String], separator: String) -> String:
    var output = ""
    var index: Int = 0
    while index < values.size():
        if index > 0:
            output = output + separator
        output = output + values.get(index)
        index += 1
    return output

# True when the value begins with the prefix. Case-sensitive; an empty prefix
# always matches.
func starts_with(value: String, prefix: String) -> Bool:
    if prefix.length() > value.length():
        return false
    return value.substring(0, prefix.length()) == prefix

# True when the value ends with the suffix. Case-sensitive; an empty suffix
# always matches.
func ends_with(value: String, suffix: String) -> Bool:
    if suffix.length() > value.length():
        return false
    return value.substring(value.length() - suffix.length(), value.length()) == suffix

# The parts between occurrences of the literal separator, empty parts kept:
# split("a,,b", ",") is ["a", "", "b"] and split("", ",") is [""]. An empty
# separator throws Error.
func split(value: String, separator: String) -> List[String] throws Error:
    if separator.length() == 0:
        throw Error("split separator must not be empty")
    let output: MutableList[String] = []
    var start: Int = 0
    var index: Int = 0
    while index + separator.length() <= value.length():
        if value.substring(index, index + separator.length()) == separator:
            output.append(value.substring(start, index))
            index += separator.length()
            start = index
        else:
            index += 1
    output.append(value.substring(start, value.length()))
    return output.toList()

# The lines without their endings, split at LF or CRLF (a lone CR is kept).
# A final line ending leaves a last "" item, and "" gives [""].
func lines(value: String) -> List[String]:
    let output: MutableList[String] = []
    var start: Int = 0
    var index: Int = 0
    while index < value.length():
        if value.charAt(index) == "\n":
            var end = index
            if end > start and value.charAt(end - 1) == "\r":
                end -= 1
            output.append(value.substring(start, end))
            start = index + 1
        index += 1
    output.append(value.substring(start, value.length()))
    return output.toList()

# The value without leading and trailing ASCII spaces, tabs, CR and LF; other
# whitespace, such as a no-break space, is kept.
func trim(value: String) -> String:
    var start: Int = 0
    var end = value.length()
    while start < end and (value.charAt(start) == " " or value.charAt(start) == "\t" or value.charAt(start) == "\r" or value.charAt(start) == "\n"):
        start += 1
    while end > start and (value.charAt(end - 1) == " " or value.charAt(end - 1) == "\t" or value.charAt(end - 1) == "\r" or value.charAt(end - 1) == "\n"):
        end -= 1
    return value.substring(start, end)

# Pads to width code points. The fill repeats as often as needed and its last
# repetition is cut to fit. A value already that long, or an empty fill,
# returns the value unchanged.
func pad_left(value: String, width: Int, fill: String) -> String:
    if width <= value.length() or fill.length() == 0:
        return value
    let missing = width - value.length()
    return fill.repeat(missing.divTrunc(fill.length()) + 1).substring(0, missing) + value

# Like pad_left, but the fill goes after the value: pad_right("ab", 5, "xy")
# is "abxyx". A value already that long, or an empty fill, comes back unchanged.
func pad_right(value: String, width: Int, fill: String) -> String:
    if width <= value.length() or fill.length() == 0:
        return value
    let missing = width - value.length()
    return value + fill.repeat(missing.divTrunc(fill.length()) + 1).substring(0, missing)

# True for a non-empty value made only of the ASCII digits 0-9.
func is_ascii_digit(value: String) -> Bool:
    for element in value:
        let code = element.codeAt(0)
        if code < 48 or code > 57:
            return false
    return value.length() > 0

# True for a non-empty value made only of the ASCII letters A-Z and a-z.
func is_ascii_letter(value: String) -> Bool:
    for element in value:
        let code = element.codeAt(0)
        if code < 65 or (code > 90 and code < 97) or code > 122:
            return false
    return value.length() > 0

# The value without the prefix, or unchanged when it does not start with it.
func strip_prefix(value: String, prefix: String) -> String:
    if starts_with(value, prefix):
        return value.substring(prefix.length(), value.length())
    return value

# The value without the suffix, or unchanged when it does not end with it.
func strip_suffix(value: String, suffix: String) -> String:
    if ends_with(value, suffix):
        return value.substring(0, value.length() - suffix.length())
    return value

# A finite Float as plain fixed-point text with that many decimals, rounded
# half away from zero: fixed(2.5, 0) is "3" and fixed(1.005, 2) is "1.01".
func fixed(value: Float, decimals: Int) -> String throws Error:
    if decimals < 0:
        throw Error("fixed decimals must not be negative: " + decimals)
    if not value.isFinite():
        throw Error("fixed needs a finite value: " + value)
    let mode = RoundingMode.HALF_UP
    let exact = BigDecimal.valueOf(value)
    if mode != null and exact != null:
        let scaled = exact.setScale(decimals.toInt32Exact(), mode)
        if scaled != null:
            let text = scaled.toPlainString()
            if text != null:
                return text
    throw Error("host returned no fixed-point text")
