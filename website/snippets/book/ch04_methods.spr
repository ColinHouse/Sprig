let s = "Hello, world"
print(s.isEmpty())
print("".isEmpty())
print(s.charAt(1))
print(s.codeAt(1))
print(s.indexOf("world"))
print(s.lastIndexOf("l"))
print(s.endsWith("world"))
print(s.contains("lo, w"))
print(s.repeat(2))
print(s.replace("world", "Sprig"))
print("  42  ".trim().toInt() + 1)
print("2.5".toFloat() * 2.0)
print(7.toString() + "!")
