import sprig.runtime.host.HostProcess as HostProcess
import sprig.runtime.host.HostSystem as HostSystem

# The command-line arguments in order: with sprig run, the ones after `--`.
# The list is empty when there are none.
func arguments() -> List[String] throws Error:
    let values: MutableList[String] = []
    var index: Int = 0
    while index < HostSystem.argumentCount():
        values.append(argument(index))
        index += 1
    return values.toList()

# The command-line argument at index, counting from 0 as in arguments(). An
# index outside 0..count-1, where count is arguments().size(), throws Error.
func argument(index: Int) -> String throws Error:
    if index < 0 or index >= HostSystem.argumentCount():
        throw Error("argument index out of bounds: " + index.toString())
    let value = HostSystem.argument(index)
    if value != null:
        return value
    throw Error("host argument returned null")

# The value of the environment variable, or null when it is not set. A
# variable set to the empty string gives "", not null.
func environment(name: String) -> String?:
    return HostSystem.environment(name)

# Ends the program with an exit status from 0 to 255; 0 means success. Text
# printed so far is flushed first. The checker does not know that exit never
# returns, so a function that must return a value still needs a return or a
# throw after it.
func exit(status: Int) -> Unit:
    HostSystem.exit(status)

# Writes one line to standard error, for messages that are not program output.
func print_error(text: String) -> Unit:
    HostSystem.printError(text)

# The next line of standard input without its line ending, or null at the end
# of input. Piped or redirected input is read as UTF-8; input typed at a
# terminal uses the terminal's encoding.
func read_line() -> String? throws Error:
    return HostSystem.readLine()

# Every remaining line of standard input, without line endings.
func read_lines() -> List[String] throws Error:
    let lines: MutableList[String] = []
    while true:
        let line = HostSystem.readLine()
        if line == null:
            break
        lines.append(line)
    return lines.toList()

# Everything left on standard input, line endings included.
func read_all() -> String throws Error:
    let text = HostSystem.readAll()
    if text != null:
        return text
    throw Error("host read_all returned null")

# A finished child process. A nonzero status is an ordinary value here; only
# a host failure (no such executable, a timeout) is an Error.
class ProcessResult:
    let exit_code: Int32
    let stdout: String
    let stderr: String

# Runs an argv vector directly, with no shell, and waits for it: the first
# element is the executable. Standard input is closed; standard output and
# standard error are captured as UTF-8 and must decode. A child that runs
# longer than 30 seconds is stopped and reported as an Error.
func run(command: List[String]) -> ProcessResult throws Error:
    let host = HostProcess.command()
    if host != null:
        for argument in command:
            host.add(argument)
        let result = host.run()
        if result != null:
            let output = result.stdout
            let errors = result.stderr
            if output != null and errors != null:
                return ProcessResult(exit_code=result.exitCode, stdout=output, stderr=errors)
    throw Error("host returned no process result")
