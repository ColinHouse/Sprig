func read_count(text: String) -> Int throws Error:
    let value = text.toIntOrNull()
    if value == null:
        throw Error("not a number: " + text)
    return value

func load(text: String) -> Int throws Error:
    try:
        return read_count(text)
    catch problem: Error:
        throw Error("config: " + problem.message)

try:
    print(load("3"))
    print(load("x"))
catch problem: Error:
    print(problem.message)
