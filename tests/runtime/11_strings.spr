# String operations and conversions.

let text = "  Sprig Lang  "
print(text.trim())
print(text.trim().length())
print(text.toUpperCase())
print(text.contains("Sprig"))
print("Sprig".startsWith("Spr"))
print("Sprig".endsWith("rig"))
print("a,b,c".split(","))
print(String.join(["a", "b", "c"], "-"))
print("hello".charAt(1))
print("hello".substring(1, 4))
print("hello".indexOf("lo"))
print("abc".repeat(3))
print("banana".replace("na", "NA"))
print("42".toInt() + 1)
print("3.5".toFloat() * 2.0)
print("bad".toIntOrNull())
print("17".toIntOrNull())
print("A".codeAt(0))
print(String.fromCode(83) + String.fromCode(112))
print(Int.parse("123") + 1)
print(Int.abs(-9))
print(Int.min(3, 7))
print(Int.max(3, 7))
print(Float.sqrt(16.0))
print(Float.floor(2.9))
print(Float.ceil(2.1))
print((3.9).toIntTrunc())
print((7).toFloat() / 2.0)
print(true.toString())
print(123.toString())
print(1.25.toString())
let letters: List[String] = "ab".split("")
print(letters.size())
